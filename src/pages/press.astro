---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Press & Media - FBLA Chapter" description="Latest news, press releases, and media coverage of our FBLA chapter">
	<section class="page-header">
		<div class="container">
			<h1>Press & Media</h1>
			<p>Latest news and media coverage of our chapter</p>
		</div>
	</section>

	<section class="featured-news">
		<div class="container">
			<h2>Featured Story</h2>
			<div class="featured-article">
				<div class="featured-image">
					<img src="/press/featured-nationals.jpg" alt="FBLA Nationals Coverage" />
				</div>
				<div class="featured-content">
					<div class="article-meta">
						<span class="source">Local News Channel 7</span>
						<span class="date">March 15, 2024</span>
					</div>
					<h3>Local FBLA Chapter Dominates State Competition, Advances 8 Members to Nationals</h3>
					<p>Our FBLA chapter made headlines after an outstanding performance at the State Leadership Conference, winning first place in Business Ethics and qualifying eight members for the National Leadership Conference in Atlanta, Georgia.</p>
					<p>"This is the result of months of hard work and dedication from our students," said chapter advisor Mrs. Jennifer Martinez. "They've shown exceptional leadership and business acumen."</p>
					<a href="#" class="read-more-btn">Read Full Article</a>
				</div>
			</div>
		</div>
	</section>

	<section class="press-releases">
		<div class="container">
			<h2>Press Releases</h2>
			<div class="press-grid">
				<div class="press-card">
					<div class="press-date">
						<span class="month">Apr</span>
						<span class="day">22</span>
						<span class="year">2024</span>
					</div>
					<div class="press-content">
						<h3>FBLA Chapter Launches Financial Literacy Program for Middle School Students</h3>
						<p>Our chapter has partnered with three local middle schools to provide financial literacy workshops, teaching essential money management skills to over 200 students.</p>
						<div class="press-meta">
							<span class="category">Community Service</span>
							<a href="#" class="download-link">Download PDF</a>
						</div>
					</div>
				</div>

				<div class="press-card">
					<div class="press-date">
						<span class="month">Mar</span>
						<span class="day">10</span>
						<span class="year">2024</span>
					</div>
					<div class="press-content">
						<h3>Outstanding Chapter Award Recognizes Excellence in Leadership Development</h3>
						<p>State FBLA organization honors our chapter with the Outstanding Chapter Award for exceptional performance in competitions, community service, and member development.</p>
						<div class="press-meta">
							<span class="category">Awards</span>
							<a href="#" class="download-link">Download PDF</a>
						</div>
					</div>
				</div>

				<div class="press-card">
					<div class="press-date">
						<span class="month">Feb</span>
						<span class="day">14</span>
						<span class="year">2024</span>
					</div>
					<div class="press-content">
						<h3>FBLA Members Organize Successful Valentine's Day Fundraiser for Local Food Bank</h3>
						<p>Chapter members raised $2,500 through a Valentine's Day candy gram sale, with all proceeds donated to the Central Valley Food Bank to support families in need.</p>
						<div class="press-meta">
							<span class="category">Fundraising</span>
							<a href="#" class="download-link">Download PDF</a>
						</div>
					</div>
				</div>

				<div class="press-card">
					<div class="press-date">
						<span class="month">Jan</span>
						<span class="day">18</span>
						<span class="year">2024</span>
					</div>
					<div class="press-content">
						<h3>New Partnership with Local Chamber of Commerce Provides Mentorship Opportunities</h3>
						<p>FBLA chapter announces partnership with the City Chamber of Commerce, connecting students with business mentors and internship opportunities.</p>
						<div class="press-meta">
							<span class="category">Partnerships</span>
							<a href="#" class="download-link">Download PDF</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="media-coverage">
		<div class="container">
			<h2>Media Coverage</h2>
			<div class="media-grid">
				<div class="media-card">
					<div class="media-type tv">TV</div>
					<div class="media-content">
						<h3>"Young Entrepreneurs Making a Difference"</h3>
						<p class="media-source">Channel 7 Evening News</p>
						<p class="media-date">March 20, 2024</p>
						<p>Feature story highlighting our chapter's community service initiatives and business competition success.</p>
						<a href="#" class="media-link">Watch Video</a>
					</div>
				</div>

				<div class="media-card">
					<div class="media-type newspaper">Print</div>
					<div class="media-content">
						<h3>"Local Students Excel in State Business Competition"</h3>
						<p class="media-source">The Daily Herald</p>
						<p class="media-date">March 16, 2024</p>
						<p>Front page coverage of our state competition victories and national qualifications.</p>
						<a href="#" class="media-link">Read Article</a>
					</div>
				</div>

				<div class="media-card">
					<div class="media-type radio">Radio</div>
					<div class="media-content">
						<h3>"Student Leadership Spotlight"</h3>
						<p class="media-source">KQED Morning Edition</p>
						<p class="media-date">February 28, 2024</p>
						<p>Interview with chapter president Sarah Johnson about leadership development in FBLA.</p>
						<a href="#" class="media-link">Listen Now</a>
					</div>
				</div>

				<div class="media-card">
					<div class="media-type online">Online</div>
					<div class="media-content">
						<h3>"High School FBLA Chapter Sets Example for Community Service"</h3>
						<p class="media-source">Education Weekly</p>
						<p class="media-date">January 25, 2024</p>
						<p>National education publication features our chapter's innovative community outreach programs.</p>
						<a href="#" class="media-link">Read Online</a>
					</div>
				</div>

				<div class="media-card">
					<div class="media-type podcast">Podcast</div>
					<div class="media-content">
						<h3>"Future Business Leaders Today"</h3>
						<p class="media-source">Business Education Podcast</p>
						<p class="media-date">December 15, 2023</p>
						<p>Chapter advisor Mrs. Martinez discusses innovative teaching methods and student achievements.</p>
						<a href="#" class="media-link">Listen</a>
					</div>
				</div>

				<div class="media-card">
					<div class="media-type social">Social</div>
					<div class="media-content">
						<h3>"Viral TikTok Showcases FBLA Competition Prep"</h3>
						<p class="media-source">@LocalNewsNow</p>
						<p class="media-date">March 5, 2024</p>
						<p>Behind-the-scenes look at our competition preparation goes viral with 50K+ views.</p>
						<a href="#" class="media-link">View Post</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="media-kit">
		<div class="container">
			<h2>Media Kit</h2>
			<div class="media-kit-content">
				<div class="media-kit-text">
					<h3>Press Resources</h3>
					<p>Download our media kit for high-resolution photos, logos, fact sheets, and contact information for press inquiries.</p>
					<ul>
						<li>High-resolution chapter photos</li>
						<li>FBLA logos and branding guidelines</li>
						<li>Chapter fact sheet and statistics</li>
						<li>Officer and advisor contact information</li>
						<li>Recent press releases and announcements</li>
					</ul>
				</div>
				<div class="media-kit-download">
					<div class="download-card">
						<h4>Complete Media Kit</h4>
						<p>Everything you need for press coverage</p>
						<a href="#" class="download-btn">Download ZIP (15.2 MB)</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="contact-press">
		<div class="container">
			<h2>Press Contact</h2>
			<div class="contact-grid">
				<div class="contact-card">
					<h3>Chapter Advisor</h3>
					<h4>Mrs. Jennifer Martinez</h4>
					<p>Business Education Teacher</p>
					<div class="contact-info">
						<p><strong>Email:</strong> j.martinez@school.edu</p>
						<p><strong>Phone:</strong> (555) 123-4567 ext. 2341</p>
						<p><strong>Office:</strong> Room 205</p>
					</div>
				</div>

				<div class="contact-card">
					<h3>Chapter President</h3>
					<h4>Sarah Johnson</h4>
					<p>Student Representative</p>
					<div class="contact-info">
						<p><strong>Email:</strong> president@fbla.school.edu</p>
						<p><strong>Available:</strong> Weekdays 3:00-5:00 PM</p>
						<p><strong>Note:</strong> Student interviews require parental consent</p>
					</div>
				</div>
			</div>
		</div>
	</section>
</Layout>

<style>
	.page-header {
		background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
		color: white;
		padding: 3rem 0;
		text-align: center;
	}

	.page-header h1 {
		font-size: 3rem;
		margin-bottom: 1rem;
	}

	.page-header p {
		font-size: 1.25rem;
		opacity: 0.9;
	}

	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2rem;
	}

	.featured-news {
		padding: 4rem 0;
		background: #f8fafc;
	}

	.featured-news h2 {
		text-align: center;
		margin-bottom: 3rem;
		font-size: 2.5rem;
		color: #1e3a8a;
	}

	.featured-article {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
		background: white;
		border-radius: 12px;
		box-shadow: 0 4px 6px rgba(0,0,0,0.05);
		overflow: hidden;
	}

	.featured-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.featured-content {
		padding: 2rem;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.article-meta {
		display: flex;
		gap: 1rem;
		margin-bottom: 1rem;
		font-size: 0.875rem;
	}

	.source {
		color: #3b82f6;
		font-weight: 600;
	}

	.date {
		color: #6b7280;
	}

	.featured-content h3 {
		font-size: 1.75rem;
		color: #1e3a8a;
		margin-bottom: 1rem;
		line-height: 1.3;
	}

	.featured-content p {
		line-height: 1.6;
		margin-bottom: 1rem;
		color: #4b5563;
	}

	.read-more-btn {
		color: #3b82f6;
		text-decoration: none;
		font-weight: 600;
		margin-top: auto;
	}

	.read-more-btn:hover {
		text-decoration: underline;
	}

	.press-releases {
		padding: 4rem 0;
	}

	.press-releases h2 {
		text-align: center;
		margin-bottom: 3rem;
		font-size: 2.5rem;
		color: #1e3a8a;
	}

	.press-grid {
		display: grid;
		gap: 2rem;
	}

	.press-card {
		display: grid;
		grid-template-columns: 120px 1fr;
		gap: 2rem;
		background: white;
		padding: 2rem;
		border-radius: 12px;
		box-shadow: 0 4px 6px rgba(0,0,0,0.05);
		border-left: 4px solid #3b82f6;
	}

	.press-date {
		text-align: center;
		padding: 1rem;
		background: #f8fafc;
		border-radius: 8px;
	}

	.press-date .month {
		display: block;
		font-size: 0.875rem;
		color: #6b7280;
		text-transform: uppercase;
		font-weight: 600;
	}

	.press-date .day {
		display: block;
		font-size: 2rem;
		font-weight: bold;
		color: #1e3a8a;
		line-height: 1;
	}

	.press-date .year {
		display: block;
		font-size: 0.875rem;
		color: #6b7280;
	}

	.press-content h3 {
		font-size: 1.25rem;
		color: #1e3a8a;
		margin-bottom: 1rem;
		line-height: 1.4;
	}

	.press-content p {
		line-height: 1.6;
		margin-bottom: 1rem;
		color: #4b5563;
	}

	.press-meta {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-top: 1rem;
	}

	.category {
		background: #3b82f6;
		color: white;
		padding: 0.25rem 0.75rem;
		border-radius: 20px;
		font-size: 0.75rem;
		font-weight: 600;
	}

	.download-link {
		color: #3b82f6;
		text-decoration: none;
		font-weight: 500;
		font-size: 0.875rem;
	}

	.download-link:hover {
		text-decoration: underline;
	}

	.media-coverage {
		padding: 4rem 0;
		background: #f8fafc;
	}

	.media-coverage h2 {
		text-align: center;
		margin-bottom: 3rem;
		font-size: 2.5rem;
		color: #1e3a8a;
	}

	.media-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
		gap: 2rem;
	}

	.media-card {
		background: white;
		padding: 2rem;
		border-radius: 12px;
		box-shadow: 0 4px 6px rgba(0,0,0,0.05);
		position: relative;
	}

	.media-type {
		position: absolute;
		top: 1rem;
		right: 1rem;
		padding: 0.25rem 0.75rem;
		border-radius: 20px;
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
	}

	.media-type.tv {
		background: #ef4444;
		color: white;
	}

	.media-type.newspaper {
		background: #6b7280;
		color: white;
	}

	.media-type.radio {
		background: #f59e0b;
		color: white;
	}

	.media-type.online {
		background: #10b981;
		color: white;
	}

	.media-type.podcast {
		background: #8b5cf6;
		color: white;
	}

	.media-type.social {
		background: #ec4899;
		color: white;
	}

	.media-content h3 {
		font-size: 1.25rem;
		color: #1e3a8a;
		margin-bottom: 0.5rem;
		line-height: 1.4;
		padding-right: 4rem;
	}

	.media-source {
		font-weight: 600;
		color: #3b82f6;
		margin-bottom: 0.25rem;
	}

	.media-date {
		font-size: 0.875rem;
		color: #6b7280;
		margin-bottom: 1rem;
	}

	.media-content p {
		line-height: 1.6;
		margin-bottom: 1rem;
		color: #4b5563;
	}

	.media-link {
		color: #3b82f6;
		text-decoration: none;
		font-weight: 600;
	}

	.media-link:hover {
		text-decoration: underline;
	}

	.media-kit {
		padding: 4rem 0;
	}

	.media-kit h2 {
		text-align: center;
		margin-bottom: 3rem;
		font-size: 2.5rem;
		color: #1e3a8a;
	}

	.media-kit-content {
		display: grid;
		grid-template-columns: 2fr 1fr;
		gap: 3rem;
		align-items: center;
	}

	.media-kit-text h3 {
		font-size: 1.75rem;
		color: #1e3a8a;
		margin-bottom: 1rem;
	}

	.media-kit-text p {
		line-height: 1.6;
		margin-bottom: 1.5rem;
		color: #4b5563;
	}

	.media-kit-text ul {
		list-style: none;
		padding: 0;
	}

	.media-kit-text li {
		padding: 0.5rem 0;
		padding-left: 1.5rem;
		position: relative;
		color: #4b5563;
	}

	.media-kit-text li:before {
		content: "✓";
		position: absolute;
		left: 0;
		color: #10b981;
		font-weight: bold;
	}

	.download-card {
		background: white;
		padding: 2rem;
		border-radius: 12px;
		box-shadow: 0 4px 6px rgba(0,0,0,0.05);
		text-align: center;
		border: 2px solid #3b82f6;
	}

	.download-card h4 {
		font-size: 1.25rem;
		color: #1e3a8a;
		margin-bottom: 0.5rem;
	}

	.download-card p {
		color: #6b7280;
		margin-bottom: 1.5rem;
	}

	.download-btn {
		background: #3b82f6;
		color: white;
		padding: 0.75rem 1.5rem;
		border-radius: 6px;
		text-decoration: none;
		font-weight: 600;
		display: inline-block;
		transition: background 0.3s;
	}

	.download-btn:hover {
		background: #2563eb;
	}

	.contact-press {
		padding: 4rem 0;
		background: #f8fafc;
	}

	.contact-press h2 {
		text-align: center;
		margin-bottom: 3rem;
		font-size: 2.5rem;
		color: #1e3a8a;
	}

	.contact-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
	}

	.contact-card {
		background: white;
		padding: 2rem;
		border-radius: 12px;
		box-shadow: 0 4px 6px rgba(0,0,0,0.05);
	}

	.contact-card h3 {
		font-size: 1rem;
		color: #6b7280;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-bottom: 0.5rem;
	}

	.contact-card h4 {
		font-size: 1.5rem;
		color: #1e3a8a;
		margin-bottom: 0.5rem;
	}

	.contact-card > p {
		color: #6b7280;
		margin-bottom: 1.5rem;
	}

	.contact-info p {
		margin-bottom: 0.5rem;
		color: #4b5563;
	}

	.contact-info strong {
		color: #1e3a8a;
	}

	@media (max-width: 768px) {
		.page-header h1 {
			font-size: 2rem;
		}

		.featured-article {
			grid-template-columns: 1fr;
		}

		.press-card {
			grid-template-columns: 1fr;
			text-align: center;
		}

		.media-grid {
			grid-template-columns: 1fr;
		}

		.media-kit-content {
			grid-template-columns: 1fr;
		}

		.press-meta {
			flex-direction: column;
			gap: 1rem;
			align-items: flex-start;
		}
	}
</style>