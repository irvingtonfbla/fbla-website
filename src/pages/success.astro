---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Success Stories - FBLA Chapter" description="Celebrating our FBLA chapter's achievements, awards, and member success stories">
	<section class="page-header">
		<div class="container">
			<h1>Success Stories</h1>
			<p>This page is under construction. Please check back soon.</p>
		</div>
	</section>

	<section class="under-construction">
		<div class="container">
			<div class="uc-card">
				<h2>Page Under Construction</h2>
				<p>We’re updating this section. Please check back soon.</p>
				<a href="/contact" class="btn btn-primary">Contact Us</a>
			</div>
		</div>
	</section>

	<section class="achievements">
		<div class="container">
			<h2>Chapter Achievements</h2>
			<div class="achievements-grid">
				<div class="achievement-card">
					<div class="achievement-icon">
						<svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
							<path d="M12 2L15.09 8.26L22 9L17 14L18.18 21L12 17.77L5.82 21L7 14L2 9L8.91 8.26L12 2Z" fill="#fbbf24"/>
						</svg>
					</div>
					<h3>Outstanding Chapter Award</h3>
					<p class="year">2024-2025</p>
					<p>Recognized as one of the top FBLA chapters in the state for exceptional leadership, community service, and competitive performance.</p>
				</div>

				<div class="achievement-card">
					<div class="achievement-icon">
						<svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
							<path d="M12 2L15.09 8.26L22 9L17 14L18.18 21L12 17.77L5.82 21L7 14L2 9L8.91 8.26L12 2Z" fill="#10b981"/>
						</svg>
					</div>
					<h3>Community Service Excellence</h3>
					<p class="year">2023</p>
					<p>Completed over 500 hours of community service, including food drives, senior center visits, and financial literacy workshops.</p>
				</div>

				<div class="achievement-card">
					<div class="achievement-icon">
						<svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
							<path d="M12 2L15.09 8.26L22 9L17 14L18.18 21L12 17.77L5.82 21L7 14L2 9L8.91 8.26L12 2Z" fill="#3b82f6"/>
						</svg>
					</div>
					<h3>State Competition Champions</h3>
					<p class="year">2024</p>
					<p>Won 1st place in Business Ethics team event and qualified 8 members for National Leadership Conference.</p>
				</div>
			</div>
		</div>
	</section>

	<section class="member-success">
		<div class="container">
			<h2>Member Success Stories</h2>
			<div class="success-stories">
				<div class="story-card">
					<div class="story-image">
						<img src="/success-sarah.jpg" alt="Sarah's Success Story" />
					</div>
					<div class="story-content">
						<h3>Sarah Johnson - National Qualifier</h3>
						<p class="story-subtitle">Business Ethics & Public Speaking</p>
						<p>"FBLA taught me confidence and leadership skills that I never knew I had. Competing at nationals was a dream come true, and the experience opened doors to scholarship opportunities and internships."</p>
						<div class="story-achievements">
							<span class="badge">2x National Qualifier</span>
							<span class="badge">State Champion</span>
							<span class="badge">$5,000 Scholarship</span>
						</div>
					</div>
				</div>

				<div class="story-card">
					<div class="story-image">
						<img src="/success-michael.jpg" alt="Michael's Success Story" />
					</div>
					<div class="story-content">
						<h3>Michael Chen - Entrepreneur</h3>
						<p class="story-subtitle">Business Plan Competition Winner</p>
						<p>"The business plan competition in FBLA inspired me to start my own tech company. The skills I learned in research, presentation, and financial planning were invaluable for my startup journey."</p>
						<div class="story-achievements">
							<span class="badge">State Winner</span>
							<span class="badge">Startup Founder</span>
							<span class="badge">$50K Funding</span>
						</div>
					</div>
				</div>

				<div class="story-card">
					<div class="story-image">
						<img src="/success-emily.jpg" alt="Emily's Success Story" />
					</div>
					<div class="story-content">
						<h3>Emily Rodriguez - Communications Leader</h3>
						<p class="story-subtitle">Business Communication Excellence</p>
						<p>"FBLA helped me discover my passion for corporate communications. The presentation skills and professional writing experience I gained led to my internship at a Fortune 500 company."</p>
						<div class="story-achievements">
							<span class="badge">Regional Champion</span>
							<span class="badge">Fortune 500 Intern</span>
							<span class="badge">Dean's List</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="competition-results">
		<div class="container">
			<h2>Recent Competition Results</h2>
			<div class="results-table">
				<div class="table-header">
					<div class="header-cell">Event</div>
					<div class="header-cell">Member</div>
					<div class="header-cell">Level</div>
					<div class="header-cell">Placement</div>
				</div>
				<div class="table-row">
					<div class="cell">Business Ethics</div>
					<div class="cell">Sarah Johnson, Michael Chen, Emily Rodriguez</div>
					<div class="cell">State</div>
					<div class="cell placement-1st">1st Place</div>
				</div>
				<div class="table-row">
					<div class="cell">Public Speaking</div>
					<div class="cell">Sarah Johnson</div>
					<div class="cell">State</div>
					<div class="cell placement-2nd">2nd Place</div>
				</div>
				<div class="table-row">
					<div class="cell">Business Plan</div>
					<div class="cell">Michael Chen</div>
					<div class="cell">State</div>
					<div class="cell placement-1st">1st Place</div>
				</div>
				<div class="table-row">
					<div class="cell">Accounting</div>
					<div class="cell">David Kim</div>
					<div class="cell">State</div>
					<div class="cell placement-3rd">3rd Place</div>
				</div>
				<div class="table-row">
					<div class="cell">Website Design</div>
					<div class="cell">Ashley Thompson</div>
					<div class="cell">Regional</div>
					<div class="cell placement-1st">1st Place</div>
				</div>
				<div class="table-row">
					<div class="cell">Parliamentary Procedure</div>
					<div class="cell">Chapter Team</div>
					<div class="cell">Regional</div>
					<div class="cell placement-2nd">2nd Place</div>
				</div>
			</div>
		</div>
	</section>

	<section class="testimonials">
		<div class="container">
			<h2>What Our Members Say</h2>
			<div class="testimonials-grid">
				<div class="testimonial-card">
					<div class="quote-icon">"</div>
					<p>"FBLA has been the highlight of my high school experience. The friendships, skills, and opportunities I've gained are invaluable."</p>
					<div class="testimonial-author">
						<strong>- Alex Martinez, Junior</strong>
					</div>
				</div>

				<div class="testimonial-card">
					<div class="quote-icon">"</div>
					<p>"The leadership opportunities in FBLA prepared me for college and my future career in business."</p>
					<div class="testimonial-author">
						<strong>- Jessica Park, Senior</strong>
					</div>
				</div>

				<div class="testimonial-card">
					<div class="quote-icon">"</div>
					<p>"Competing in FBLA events taught me how to think critically and present ideas confidently."</p>
					<div class="testimonial-author">
						<strong>- Ryan Foster, Sophomore</strong>
					</div>
				</div>
			</div>
		</div>
	</section>
</Layout>

<style>
	.page-header {
		background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
		color: white;
		padding: 3rem 0;
		text-align: center;
	}

	.page-header h1 {
		font-size: 3rem;
		margin-bottom: 1rem;
	}

	.page-header p {
		font-size: 1.25rem;
		opacity: 0.9;
	}

	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2rem;
	}

	.under-construction {
		padding: 5rem 0;
		background: #f8fafc;
	}

	.uc-card {
		max-width: 700px;
		margin: 0 auto;
		text-align: center;
		background: white;
		border: 1px solid #e5e7eb;
		border-radius: 12px;
		padding: 2.5rem;
		box-shadow: 0 4px 6px rgba(0,0,0,0.05);
	}

	.uc-card h2 {
		font-size: 2rem;
		color: #1e3a8a;
		margin-bottom: 1rem;
	}

	.uc-card p {
		color: #4b5563;
		margin-bottom: 1.5rem;
	}

	.achievements,
	.member-success,
	.competition-results,
	.testimonials {
		display: none;
	}

	.achievements {
		padding: 4rem 0;
	}

	.achievements h2 {
		text-align: center;
		margin-bottom: 3rem;
		font-size: 2.5rem;
		color: #1e3a8a;
	}

	.achievements-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
	}

	.achievement-card {
		background: white;
		padding: 2rem;
		border-radius: 12px;
		box-shadow: 0 4px 6px rgba(0,0,0,0.05);
		text-align: center;
		transition: transform 0.3s;
	}

	.achievement-card:hover {
		transform: translateY(-5px);
	}

	.achievement-icon {
		margin-bottom: 1rem;
	}

	.achievement-card h3 {
		font-size: 1.5rem;
		color: #1e3a8a;
		margin-bottom: 0.5rem;
	}

	.year {
		font-weight: 600;
		color: #3b82f6;
		margin-bottom: 1rem;
	}

	.member-success {
		padding: 4rem 0;
		background: #f8fafc;
	}

	.member-success h2 {
		text-align: center;
		margin-bottom: 3rem;
		font-size: 2.5rem;
		color: #1e3a8a;
	}

	.success-stories {
		display: grid;
		gap: 3rem;
	}

	.story-card {
		display: grid;
		grid-template-columns: 200px 1fr;
		gap: 2rem;
		background: white;
		padding: 2rem;
		border-radius: 12px;
		box-shadow: 0 4px 6px rgba(0,0,0,0.05);
	}

	.story-image {
		height: 200px;
		overflow: hidden;
		border-radius: 8px;
	}

	.story-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.story-content h3 {
		font-size: 1.5rem;
		color: #1e3a8a;
		margin-bottom: 0.5rem;
	}

	.story-subtitle {
		font-weight: 600;
		color: #3b82f6;
		margin-bottom: 1rem;
	}

	.story-content p {
		line-height: 1.6;
		margin-bottom: 1.5rem;
		color: #4b5563;
		font-style: italic;
	}

	.story-achievements {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.badge {
		background: #3b82f6;
		color: white;
		padding: 0.25rem 0.75rem;
		border-radius: 20px;
		font-size: 0.875rem;
		font-weight: 500;
	}

	.competition-results {
		padding: 4rem 0;
	}

	.competition-results h2 {
		text-align: center;
		margin-bottom: 3rem;
		font-size: 2.5rem;
		color: #1e3a8a;
	}

	.results-table {
		background: white;
		border-radius: 12px;
		box-shadow: 0 4px 6px rgba(0,0,0,0.05);
		overflow: hidden;
	}

	.table-header {
		display: grid;
		grid-template-columns: 2fr 3fr 1fr 1fr;
		background: #1e3a8a;
		color: white;
	}

	.header-cell {
		padding: 1rem;
		font-weight: 600;
	}

	.table-row {
		display: grid;
		grid-template-columns: 2fr 3fr 1fr 1fr;
		border-bottom: 1px solid #e5e7eb;
	}

	.table-row:last-child {
		border-bottom: none;
	}

	.cell {
		padding: 1rem;
		color: #4b5563;
	}

	.placement-1st {
		color: #fbbf24;
		font-weight: 600;
	}

	.placement-2nd {
		color: #9ca3af;
		font-weight: 600;
	}

	.placement-3rd {
		color: #cd7c2f;
		font-weight: 600;
	}

	.testimonials {
		padding: 4rem 0;
		background: #f8fafc;
	}

	.testimonials h2 {
		text-align: center;
		margin-bottom: 3rem;
		font-size: 2.5rem;
		color: #1e3a8a;
	}

	.testimonials-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
	}

	.testimonial-card {
		background: white;
		padding: 2rem;
		border-radius: 12px;
		box-shadow: 0 4px 6px rgba(0,0,0,0.05);
		position: relative;
	}

	.quote-icon {
		font-size: 4rem;
		color: #3b82f6;
		line-height: 1;
		margin-bottom: 1rem;
	}

	.testimonial-card p {
		line-height: 1.6;
		margin-bottom: 1rem;
		color: #4b5563;
		font-style: italic;
	}

	.testimonial-author {
		color: #1e3a8a;
	}

	@media (max-width: 768px) {
		.page-header h1 {
			font-size: 2rem;
		}

		.story-card {
			grid-template-columns: 1fr;
			text-align: center;
		}

		.table-header,
		.table-row {
			grid-template-columns: 1fr;
			gap: 0.5rem;
		}

		.header-cell,
		.cell {
			padding: 0.5rem;
			text-align: left;
		}

		.header-cell:before,
		.cell:before {
			content: attr(data-label) ": ";
			font-weight: 600;
			display: inline-block;
			width: 100px;
		}
	}
</style>
