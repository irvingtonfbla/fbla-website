---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Edit Website" active="edit-website">
  <div class="page-header">
    <div>
      <h1>Edit Website</h1>
      <p>Manage resource links, gallery, and public page content</p>
    </div>
    <button class="btn btn-primary" id="add-resource-btn">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Add Link
    </button>
  </div>

  <div class="page-body">

    <!-- Gallery placeholder -->
    <div class="card section-card" style="margin-bottom:1.5rem">
      <div style="display:flex;align-items:flex-start;gap:1.25rem">
        <div class="gallery-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
        </div>
        <div>
          <h2 class="section-title" style="margin-bottom:0.35rem">Gallery Manager</h2>
          <p style="color:#64748b;font-size:0.875rem;margin:0 0 0.75rem">Coming soon — upload and manage gallery photos via GitHub API.</p>
          <p style="color:#94a3b8;font-size:0.8rem;margin:0">In the meantime, push images to <code class="code-inline">public/gallery/</code> in the GitHub repo and they will appear automatically on the public site.</p>
        </div>
      </div>
    </div>

    <!-- Resources loading -->
    <div id="resources-loading" class="empty-state">
      <div class="loading-spinner" style="margin:0 auto 1rem"></div>
      <p>Loading resources…</p>
    </div>

    <!-- Resources grid (grouped by category) -->
    <div id="resources-content" style="display:none"></div>

  </div>

  <!-- Add/Edit Resource Modal -->
  <div class="modal-overlay" id="resource-modal">
    <div class="modal" style="max-width:520px">
      <div class="modal-header">
        <h2 id="resource-modal-title">Add Link</h2>
        <button class="modal-close" id="resource-modal-close">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="res-id" />
        <div class="form-group">
          <label class="form-label">Label *</label>
          <input type="text" id="res-label" class="form-control" placeholder="e.g. 2024 Photo Album" />
        </div>
        <div class="form-group">
          <label class="form-label">URL *</label>
          <input type="url" id="res-url" class="form-control" placeholder="https://drive.google.com/…" />
        </div>
        <div class="form-group">
          <label class="form-label">Category</label>
          <select id="res-category" class="form-control">
            <option value="Gallery">Gallery</option>
            <option value="Documents">Documents</option>
            <option value="Spreadsheets">Spreadsheets</option>
            <option value="Other">Other</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Description</label>
          <input type="text" id="res-desc" class="form-control" placeholder="Short description (optional)" />
        </div>
        <div style="display:flex;gap:0.75rem;justify-content:flex-end;align-items:center;margin-top:0.5rem">
          <button class="btn btn-danger btn-sm" id="res-delete-btn" style="display:none;margin-right:auto">Delete</button>
          <button class="btn btn-secondary" id="res-cancel-btn">Cancel</button>
          <button class="btn btn-primary" id="res-save-btn">Save Link</button>
        </div>
      </div>
    </div>
  </div>

  <div class="toast" id="toast"></div>
</AdminLayout>

<script>
const pw = () => localStorage.getItem('fbla_admin_pw') || '';
const h = () => ({ 'Content-Type': 'application/json', Authorization: `Bearer ${pw()}` });
const API = '/.netlify/functions/dashboard';

const CATEGORIES = ['Gallery', 'Documents', 'Spreadsheets', 'Other'];
const CAT_COLORS: Record<string, string> = {
  Gallery: '#8b5cf6',
  Documents: '#3b82f6',
  Spreadsheets: '#15803d',
  Other: '#f97316',
};
const CAT_ICONS: Record<string, string> = {
  Gallery: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>`,
  Documents: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>`,
  Spreadsheets: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="9" x2="9" y2="21"/></svg>`,
  Other: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>`,
};

let allResources: any[] = [];
let editingId: string | null = null;

function toast(msg: string, type = 'success') {
  const el = document.getElementById('toast')!;
  el.textContent = msg; el.className = `toast ${type} show`;
  setTimeout(() => el.classList.remove('show'), 3000);
}

async function loadResources() {
  try {
    const r = await fetch(`${API}?resource=website-resources`, { headers: h() });
    if (r.ok) {
      const d = await r.json();
      allResources = d.items || [];
    }
  } catch {}
  renderResources();
}

function renderResources() {
  const loading = document.getElementById('resources-loading')!;
  const content = document.getElementById('resources-content')!;
  loading.style.display = 'none';
  content.style.display = '';

  if (allResources.length === 0) {
    content.innerHTML = `<div class="empty-state card" style="padding:3rem">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="opacity:0.3;margin-bottom:1rem"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
      <p>No resource links yet. Click "+ Add Link" to get started.</p>
    </div>`;
    return;
  }

  const grouped: Record<string, any[]> = {};
  CATEGORIES.forEach(c => { grouped[c] = []; });
  allResources.forEach(r => {
    const cat = r.category || 'Other';
    if (!grouped[cat]) grouped[cat] = [];
    grouped[cat].push(r);
  });

  content.innerHTML = CATEGORIES.filter(c => grouped[c].length > 0).map(cat => `
    <div class="section-card card" style="margin-bottom:1.25rem">
      <div class="cat-header">
        <span class="cat-icon" style="color:${CAT_COLORS[cat]}">${CAT_ICONS[cat]}</span>
        <h2 class="section-title" style="margin:0">${cat}</h2>
        <span class="cat-count">${grouped[cat].length}</span>
      </div>
      <div class="res-grid">
        ${grouped[cat].map(r => `
          <div class="res-card">
            <div class="res-card-body">
              <div class="res-label">${r.label}</div>
              ${r.description ? `<div class="res-desc">${r.description}</div>` : ''}
              <div class="res-url">${r.url}</div>
            </div>
            <div class="res-card-actions">
              <a href="${r.url}" target="_blank" class="btn btn-secondary btn-sm">Open</a>
              <button class="btn-icon res-edit-btn" data-id="${r.id}" title="Edit">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
              </button>
            </div>
          </div>
        `).join('')}
      </div>
    </div>
  `).join('');

  content.querySelectorAll('.res-edit-btn').forEach(btn => {
    btn.addEventListener('click', () => openEdit((btn as HTMLElement).dataset.id!));
  });
}

function openAdd() {
  editingId = null;
  document.getElementById('resource-modal-title')!.textContent = 'Add Link';
  document.getElementById('res-delete-btn')!.style.display = 'none';
  (document.getElementById('res-id') as HTMLInputElement).value = '';
  (document.getElementById('res-label') as HTMLInputElement).value = '';
  (document.getElementById('res-url') as HTMLInputElement).value = '';
  (document.getElementById('res-category') as HTMLSelectElement).value = 'Gallery';
  (document.getElementById('res-desc') as HTMLInputElement).value = '';
  document.getElementById('resource-modal')!.classList.add('open');
  (document.getElementById('res-label') as HTMLInputElement).focus();
}

function openEdit(id: string) {
  const r = allResources.find(x => x.id === id);
  if (!r) return;
  editingId = id;
  document.getElementById('resource-modal-title')!.textContent = 'Edit Link';
  document.getElementById('res-delete-btn')!.style.display = '';
  (document.getElementById('res-id') as HTMLInputElement).value = id;
  (document.getElementById('res-label') as HTMLInputElement).value = r.label || '';
  (document.getElementById('res-url') as HTMLInputElement).value = r.url || '';
  (document.getElementById('res-category') as HTMLSelectElement).value = r.category || 'Other';
  (document.getElementById('res-desc') as HTMLInputElement).value = r.description || '';
  document.getElementById('resource-modal')!.classList.add('open');
}

function closeModal() { document.getElementById('resource-modal')!.classList.remove('open'); }

document.getElementById('add-resource-btn')?.addEventListener('click', openAdd);
document.getElementById('resource-modal-close')?.addEventListener('click', closeModal);
document.getElementById('res-cancel-btn')?.addEventListener('click', closeModal);
document.getElementById('resource-modal')?.addEventListener('click', e => { if (e.target === e.currentTarget) closeModal(); });

document.getElementById('res-save-btn')?.addEventListener('click', async () => {
  const label = (document.getElementById('res-label') as HTMLInputElement).value.trim();
  const url = (document.getElementById('res-url') as HTMLInputElement).value.trim();
  if (!label || !url) { toast('Label and URL are required', 'error'); return; }

  const payload = {
    label,
    url,
    category: (document.getElementById('res-category') as HTMLSelectElement).value,
    description: (document.getElementById('res-desc') as HTMLInputElement).value.trim() || null,
  };

  const btn = document.getElementById('res-save-btn') as HTMLButtonElement;
  btn.textContent = 'Saving…'; btn.disabled = true;

  try {
    if (editingId) {
      await fetch(`${API}?resource=website-resources`, { method: 'PUT', headers: h(), body: JSON.stringify({ id: editingId, ...payload }) });
    } else {
      await fetch(`${API}?resource=website-resources`, { method: 'POST', headers: h(), body: JSON.stringify(payload) });
    }
    await loadResources();
    closeModal();
    toast(editingId ? 'Link updated' : 'Link added');
  } catch { toast('Failed to save', 'error'); }
  finally { btn.textContent = 'Save Link'; btn.disabled = false; }
});

document.getElementById('res-delete-btn')?.addEventListener('click', async () => {
  if (!editingId || !confirm('Delete this link?')) return;
  await fetch(`${API}?resource=website-resources`, { method: 'DELETE', headers: h(), body: JSON.stringify({ id: editingId }) });
  await loadResources();
  closeModal();
  toast('Link deleted');
});

loadResources();
</script>

<style>
.section-title { font-size: 0.95rem; font-weight: 700; color: #0f172a; margin: 0 0 1.25rem; }
.section-card { margin-bottom: 1.25rem; }

.gallery-icon { color: #8b5cf6; flex-shrink: 0; margin-top: 0.1rem; }
.code-inline { background: #f1f5f9; padding: 0.15rem 0.4rem; border-radius: 4px; font-size: 0.8rem; font-family: 'Courier New', monospace; color: #1e3a8a; }

.cat-header { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 1rem; }
.cat-icon { display: flex; align-items: center; flex-shrink: 0; }
.cat-count { background: #f1f5f9; color: #64748b; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.45rem; border-radius: 50px; margin-left: auto; }

.res-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 0.875rem; }
.res-card { border: 1px solid #e2e8f0; border-radius: 10px; padding: 1rem; background: #fafafa; display: flex; justify-content: space-between; align-items: flex-start; gap: 0.75rem; transition: border-color 0.15s; }
.res-card:hover { border-color: #94a3b8; }
.res-card-body { flex: 1; min-width: 0; }
.res-label { font-weight: 700; color: #1e293b; font-size: 0.9rem; }
.res-desc { font-size: 0.8rem; color: #64748b; margin-top: 0.15rem; }
.res-url { font-size: 0.72rem; color: #94a3b8; margin-top: 0.3rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 200px; }
.res-card-actions { display: flex; gap: 0.4rem; align-items: center; flex-shrink: 0; }
</style>
