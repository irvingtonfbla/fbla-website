let allMembers: any[] = [];
let activeView: 'roster' | 'leaderboard' = 'roster';

const OFFICER_ROLES = new Set(['President','Vice President','Secretary','Treasurer','Reporter','Parliamentarian','Historian','Officer']);

const ROLE_COLORS: Record<string,string> = {
  President:'badge-blue','Vice President':'badge-purple',Secretary:'badge-teal',
  Treasurer:'badge-green',Reporter:'badge-orange',Parliamentarian:'badge-orange',
  Historian:'badge-orange',Officer:'badge-blue',Member:'badge-gray',
};

function toast(msg: string, type = 'success') {
  const el = document.getElementById('toast')!;
  el.textContent = msg; el.className = `toast ${type} show`;
  setTimeout(() => el.classList.remove('show'), 3000);
}

function tallyMarks(n: number): string {
  if (n === 0) return '<span class="dim">—</span>';
  const groups = Math.floor(n / 5);
  const rem = n % 5;
  let svg = '';
  for (let g = 0; g < groups; g++) {
    svg += `<svg width="26" height="22" viewBox="0 0 26 22" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round" style="flex-shrink:0"><line x1="3" y1="1" x2="3" y2="21"/><line x1="9" y1="1" x2="9" y2="21"/><line x1="15" y1="1" x2="15" y2="21"/><line x1="21" y1="1" x2="21" y2="21"/><line x1="0" y1="19" x2="26" y2="3"/></svg>`;
  }
  if (rem > 0) {
    const w = 4 + rem * 6;
    svg += `<svg width="${w}" height="22" viewBox="0 0 ${w} 22" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round" style="flex-shrink:0">`;
    for (let i = 0; i < rem; i++) svg += `<line x1="${3+i*6}" y1="1" x2="${3+i*6}" y2="21"/>`;
    svg += `</svg>`;
  }
  return `<span class="tally" title="${n} strike${n!==1?'s':''}">${svg}</span>`;
}

function pointsBadge(pts: number): string {
  const cls = pts >= 100 ? 'pts-high' : pts >= 50 ? 'pts-mid' : 'pts-low';
  return `<span class="pts-badge ${cls}">${pts}</span>`;
}

function renderStats(members: any[]) {
  const total = members.length;
  const officers = members.filter(m => OFFICER_ROLES.has(m.role)).length;
  const mems = total - officers;
  const avg = total > 0 ? Math.round(members.reduce((s,m) => s + (m.points||0), 0) / total) : 0;
  document.getElementById('stat-total')!.textContent = String(total);
  document.getElementById('stat-officers')!.textContent = String(officers);
  document.getElementById('stat-members')!.textContent = String(mems);
  document.getElementById('stat-avg-pts')!.textContent = String(avg);
}

function memberRow(m: any): string {
  const strikes = m.strikes || 0;
  return `<tr${strikes > 0 ? ' class="has-strikes"' : ''}>
    <td class="name-cell">
      <div class="avatar">${(m.firstName?.[0]||'?')}${(m.lastName?.[0]||'')}</div>
      <div>
        <div style="font-weight:600;color:#1e293b">${m.firstName} ${m.lastName}</div>
        ${m.notes ? `<div style="font-size:0.72rem;color:#94a3b8;margin-top:1px">${m.notes}</div>` : ''}
      </div>
    </td>
    <td><span class="badge ${ROLE_COLORS[m.role]||'badge-gray'}">${m.role}</span></td>
    <td class="points-cell">${pointsBadge(m.points||0)}</td>
    <td class="strikes-cell">
      <div class="strike-controls">
        <button class="strike-btn strike-minus" data-id="${m.id}" title="Remove strike">−</button>
        ${tallyMarks(strikes)}
        <button class="strike-btn strike-plus" data-id="${m.id}" title="Add strike">+</button>
      </div>
    </td>
    <td class="email-cell">${m.email ? `<a href="mailto:${m.email}" class="email-link">${m.email}</a>` : '<span class="dim">—</span>'}</td>
    <td>${m.grade ? `${m.grade}th` : '<span class="dim">—</span>'}</td>
    <td class="actions-cell">
      <button class="btn-icon edit-btn" data-id="${m.id}" title="Edit">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
      </button>
      <button class="btn-icon delete-btn" data-id="${m.id}" title="Delete">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>
      </button>
    </td>
  </tr>`;
}

function renderRoster(members: any[]) {
  const body = document.getElementById('roster-body')!;
  const table = document.getElementById('roster-table')!;
  table.style.display = 'table';

  if (members.length === 0) {
    body.innerHTML = '<tr><td colspan="7" style="text-align:center;color:#94a3b8;padding:3rem">No members match your search</td></tr>';
    return;
  }

  const officers = members.filter(m => OFFICER_ROLES.has(m.role));
  const regularMembers = members.filter(m => !OFFICER_ROLES.has(m.role)).sort((a,b) => (b.points||0) - (a.points||0));

  let html = '';

  if (officers.length > 0) {
    html += `<tr class="section-header"><td colspan="7"><div class="section-label">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#1e3a8a" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
      Officers <span class="section-count">${officers.length}</span>
    </div></td></tr>`;
    html += officers.map(m => memberRow(m)).join('');
  }

  if (regularMembers.length > 0) {
    html += `<tr class="section-header"><td colspan="7"><div class="section-label">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#475569" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
      Members <span class="section-count">${regularMembers.length}</span>
    </div></td></tr>`;
    html += regularMembers.map(m => memberRow(m)).join('');
  }

  body.innerHTML = html;
  bindRowButtons(body);
}

function renderLeaderboard(members: any[]) {
  const sorted = [...members].sort((a,b) => (b.points||0) - (a.points||0));
  const maxPts = sorted[0]?.points || 1;

  const podium = document.getElementById('podium')!;
  const top3 = sorted.slice(0, 3);
  const medals = ['\u{1F947}','\u{1F948}','\u{1F949}'];
  const pColors = [
    {bg:'linear-gradient(135deg,#fef9c3,#fde68a)',border:'#f59e0b',text:'#92400e'},
    {bg:'linear-gradient(135deg,#f1f5f9,#e2e8f0)',border:'#94a3b8',text:'#475569'},
    {bg:'linear-gradient(135deg,#fed7aa,#fdba74)',border:'#f97316',text:'#9a3412'},
  ];

  podium.innerHTML = top3.map((m,i) => `
    <div class="podium-card" style="background:${pColors[i].bg};border-color:${pColors[i].border}">
      <div class="podium-medal">${medals[i]}</div>
      <div class="podium-rank" style="color:${pColors[i].text}">#${i+1}</div>
      <div class="podium-avatar">${(m.firstName?.[0]||'')}${(m.lastName?.[0]||'')}</div>
      <div class="podium-name">${m.firstName} ${m.lastName}</div>
      <span class="badge ${ROLE_COLORS[m.role]||'badge-gray'}" style="font-size:0.7rem">${m.role}</span>
      <div class="podium-pts" style="color:${pColors[i].text}">${m.points||0} pts</div>
      <div class="podium-bar"><div class="podium-bar-fill" style="width:${((m.points||0)/maxPts*100)}%;background:${pColors[i].border}"></div></div>
    </div>
  `).join('');

  const body = document.getElementById('lb-body')!;
  body.innerHTML = sorted.slice(3).map((m,i) => {
    const rank = i + 4;
    const pct = ((m.points||0)/maxPts*100);
    const strikes = m.strikes || 0;
    return `<tr${strikes > 0 ? ' class="has-strikes"' : ''}>
      <td class="rank-cell"><span class="rank-num">${rank}</span></td>
      <td class="name-cell">
        <div class="avatar">${(m.firstName?.[0]||'?')}${(m.lastName?.[0]||'')}</div>
        <div>
          <span style="font-weight:600;color:#1e293b">${m.firstName} ${m.lastName}</span>
          ${strikes > 0 ? `<span style="color:#dc2626;font-size:0.72rem;margin-left:0.4rem">${strikes} strike${strikes>1?'s':''}</span>` : ''}
        </div>
      </td>
      <td class="lb-pts-cell">
        <div class="lb-pts-wrap">
          <span class="lb-pts-num">${m.points||0}</span>
          <div class="lb-pts-bar"><div class="lb-pts-fill" style="width:${pct}%"></div></div>
        </div>
      </td>
      <td><span class="badge ${ROLE_COLORS[m.role]||'badge-gray'}">${m.role}</span></td>
    </tr>`;
  }).join('');
}

function bindRowButtons(container: HTMLElement) {
  container.querySelectorAll('.edit-btn').forEach(btn => btn.addEventListener('click', () => openEdit((btn as HTMLElement).dataset.id!)));
  container.querySelectorAll('.delete-btn').forEach(btn => btn.addEventListener('click', () => deleteMember((btn as HTMLElement).dataset.id!)));
  container.querySelectorAll('.strike-plus').forEach(btn => btn.addEventListener('click', (e) => { e.stopPropagation(); adjustStrike((btn as HTMLElement).dataset.id!, 1); }));
  container.querySelectorAll('.strike-minus').forEach(btn => btn.addEventListener('click', (e) => { e.stopPropagation(); adjustStrike((btn as HTMLElement).dataset.id!, -1); }));
}

function applyFilters() {
  const q = (document.getElementById('search-input') as HTMLInputElement).value.toLowerCase();
  const role = (document.getElementById('role-filter') as HTMLSelectElement).value;
  const filtered = allMembers.filter(m => {
    const name = `${m.firstName} ${m.lastName}`.toLowerCase();
    const matchQ = !q || name.includes(q) || (m.email||'').toLowerCase().includes(q);
    const matchRole = !role || m.role === role;
    return matchQ && matchRole;
  });
  renderStats(filtered);
  if (activeView === 'roster') renderRoster(filtered);
  else renderLeaderboard(filtered);
}

async function load() {
  const loading = document.getElementById('loading-state')!;
  try {
    const rosterRes = await fetch(API, { headers });
    const rosterData = await rosterRes.json();
    if ((rosterData.items || []).length > 0) {
      allMembers = rosterData.items;
    } else {
      allMembers = [...DEMO_MEMBERS];
    }
  } catch {
    allMembers = [...DEMO_MEMBERS];
  }

  allMembers.sort((a: any, b: any) => {
    const aOff = OFFICER_ROLES.has(a.role);
    const bOff = OFFICER_ROLES.has(b.role);
    if (aOff !== bOff) return aOff ? -1 : 1;
    return `${a.lastName}${a.firstName}`.localeCompare(`${b.lastName}${b.firstName}`);
  });

  loading.style.display = 'none';
  applyFilters();
}

function adjustStrike(id: string, delta: number) {
  const m = allMembers.find(x => x.id === id);
  if (!m) return;
  const newStrikes = Math.max(0, (m.strikes||0) + delta);
  if (newStrikes === m.strikes) return;
  m.strikes = newStrikes;
  m.points = Math.max(0, (m.points||0) + (delta > 0 ? -25 : 25));
  applyFilters();
  toast(delta > 0 ? `Strike added to ${m.firstName} ${m.lastName}` : `Strike removed from ${m.firstName} ${m.lastName}`);
  fetch(`${API_BASE}?resource=strikes`, {
    method: 'POST', headers,
    body: JSON.stringify({ officerName: `${m.firstName} ${m.lastName}`, count: newStrikes, history: [] }),
  }).catch(() => {});
}

// View toggle
document.getElementById('view-toggle')!.addEventListener('click', () => {
  activeView = activeView === 'roster' ? 'leaderboard' : 'roster';
  document.getElementById('roster-view')!.style.display = activeView === 'roster' ? '' : 'none';
  document.getElementById('leaderboard-view')!.style.display = activeView === 'leaderboard' ? '' : 'none';
  const btn = document.getElementById('view-toggle')!;
  if (activeView === 'roster') {
    btn.innerHTML = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg> Leaderboard';
  } else {
    btn.innerHTML = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg> Roster';
  }
  applyFilters();
});

// Modal
const modal = document.getElementById('modal')!;
const editId = document.getElementById('edit-id') as HTMLInputElement;
const fFirst = document.getElementById('f-first') as HTMLInputElement;
const fLast = document.getElementById('f-last') as HTMLInputElement;
const fRole = document.getElementById('f-role') as HTMLSelectElement;
const fGrade = document.getElementById('f-grade') as HTMLSelectElement;
const fEmail = document.getElementById('f-email') as HTMLInputElement;
const fNotes = document.getElementById('f-notes') as HTMLInputElement;

function openAdd() {
  editId.value = ''; fFirst.value = ''; fLast.value = ''; fRole.value = 'Member';
  fGrade.value = ''; fEmail.value = ''; fNotes.value = '';
  document.getElementById('modal-title')!.textContent = 'Add Member';
  modal.classList.add('open'); fFirst.focus();
}

function openEdit(id: string) {
  const m = allMembers.find(x => x.id === id);
  if (!m) return;
  editId.value = id;
  fFirst.value = m.firstName || '';
  fLast.value = m.lastName || '';
  fRole.value = m.role || 'Member';
  fGrade.value = m.grade || '';
  fEmail.value = m.email || '';
  fNotes.value = m.notes || '';
  document.getElementById('modal-title')!.textContent = 'Edit Member';
  modal.classList.add('open');
}

function closeModal() { modal.classList.remove('open'); }

document.getElementById('add-btn')!.addEventListener('click', openAdd);
document.getElementById('modal-close')!.addEventListener('click', closeModal);
document.getElementById('modal-cancel')!.addEventListener('click', closeModal);
modal.addEventListener('click', e => { if (e.target === modal) closeModal(); });

document.getElementById('modal-save')!.addEventListener('click', async () => {
  const firstName = fFirst.value.trim();
  const lastName = fLast.value.trim();
  if (!firstName || !lastName) { toast('First and last name required', 'error'); return; }

  const body = { firstName, lastName, role: fRole.value, grade: fGrade.value, email: fEmail.value.trim(), notes: fNotes.value.trim() };
  const id = editId.value;

  if (id) {
    const m = allMembers.find(x => x.id === id);
    if (m) Object.assign(m, body);
  } else {
    allMembers.push({ ...body, id: 'new-' + Date.now(), points: 0, strikes: 0 });
  }

  closeModal();
  allMembers.sort((a: any, b: any) => {
    const aOff = OFFICER_ROLES.has(a.role);
    const bOff = OFFICER_ROLES.has(b.role);
    if (aOff !== bOff) return aOff ? -1 : 1;
    return `${a.lastName}${a.firstName}`.localeCompare(`${b.lastName}${b.firstName}`);
  });
  applyFilters();
  toast(id ? 'Member updated' : 'Member added');

  fetch(API, {
    method: id ? 'PUT' : 'POST', headers,
    body: JSON.stringify(id ? { id, ...body } : body),
  }).catch(() => {});
});

async function deleteMember(id: string) {
  const m = allMembers.find(x => x.id === id);
  if (!confirm(`Remove ${m?.firstName} ${m?.lastName}?`)) return;
  allMembers = allMembers.filter(x => x.id !== id);
  applyFilters();
  toast('Member removed');
  fetch(API, { method: 'DELETE', headers, body: JSON.stringify({ id }) }).catch(() => {});
}

document.getElementById('search-input')!.addEventListener('input', applyFilters);
document.getElementById('role-filter')!.addEventListener('change', applyFilters);

load();
</script>

