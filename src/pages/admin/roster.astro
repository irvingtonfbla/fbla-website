---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Member Roster" active="roster">
  <div class="page-header">
    <div>
      <h1>Member Roster</h1>
      <p>Irvington FBLA — 2025–26 School Year</p>
    </div>
    <div style="display:flex;gap:0.75rem;align-items:center;flex-wrap:wrap">
      <div class="search-wrap">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" id="search-input" placeholder="Search members..." class="search-input" />
      </div>
      <select id="role-filter" class="filter-select">
        <option value="">All Roles</option>
        <option value="President">President</option>
        <option value="Vice President">Vice President</option>
        <option value="Secretary">Secretary</option>
        <option value="Treasurer">Treasurer</option>
        <option value="Reporter">Reporter</option>
        <option value="Parliamentarian">Parliamentarian</option>
        <option value="Historian">Historian</option>
        <option value="Officer">Officer</option>
        <option value="Member">Member</option>
      </select>
      <button class="btn btn-secondary" id="view-toggle">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        Leaderboard
      </button>
      <button class="btn btn-primary" id="add-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Add Member
      </button>
    </div>
  </div>

  <div class="page-body">
    <div class="roster-stats" id="roster-stats">
      <div class="stat-pill"><span id="stat-total">0</span> total</div>
      <div class="stat-pill officer"><span id="stat-officers">0</span> officers</div>
      <div class="stat-pill member"><span id="stat-members">0</span> members</div>
      <div class="stat-pill points-pill"><span id="stat-avg-pts">0</span> avg pts</div>
    </div>

    <div class="points-legend-bar">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
      <span class="plb-label">Earn Points:</span>
      <span class="plb-item green">CTE Meeting +10</span>
      <span class="plb-item gold">Win +50</span>
      <span class="plb-item blue">Compete +20</span>
      <span class="plb-item purple">Engage +5</span>
      <span class="plb-item teal">Recruit +15</span>
      <span class="plb-item red">Strike −25</span>
    </div>

    <!-- Roster View -->
    <div id="roster-view">
      <div class="card" style="padding:0;overflow:hidden">
        <div id="loading-state" class="empty-state" style="padding:3rem">
          <div class="loading-spinner" style="margin:0 auto 1rem"></div>
          <p>Loading roster...</p>
        </div>
        <table class="roster-table" id="roster-table" style="display:none">
          <thead>
            <tr>
              <th>Name</th>
              <th>Role</th>
              <th>Points</th>
              <th>Strikes</th>
              <th>Email</th>
              <th>Grade</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="roster-body"></tbody>
        </table>
      </div>
    </div>

    <!-- Leaderboard View -->
    <div id="leaderboard-view" style="display:none">
      <div id="podium" class="podium-grid"></div>
      <div class="card" style="padding:0;overflow:hidden;margin-top:1.25rem">
        <table class="roster-table lb-table" id="lb-table">
          <thead>
            <tr>
              <th style="width:50px">#</th>
              <th>Member</th>
              <th style="width:200px">Points</th>
              <th style="width:120px">Role</th>
            </tr>
          </thead>
          <tbody id="lb-body"></tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Add/Edit Modal -->
  <div class="modal-overlay" id="modal">
    <div class="modal">
      <div class="modal-header">
        <h2 id="modal-title">Add Member</h2>
        <button class="modal-close" id="modal-close">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="edit-id" />
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
          <div class="form-group">
            <label class="form-label">First Name *</label>
            <input type="text" id="f-first" class="form-control" placeholder="First name" />
          </div>
          <div class="form-group">
            <label class="form-label">Last Name *</label>
            <input type="text" id="f-last" class="form-control" placeholder="Last name" />
          </div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
          <div class="form-group">
            <label class="form-label">Role *</label>
            <select id="f-role" class="form-control">
              <option value="Member">Member</option>
              <option value="Officer">Officer</option>
              <option value="President">President</option>
              <option value="Vice President">Vice President</option>
              <option value="Secretary">Secretary</option>
              <option value="Treasurer">Treasurer</option>
              <option value="Reporter">Reporter</option>
              <option value="Parliamentarian">Parliamentarian</option>
              <option value="Historian">Historian</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Grade</label>
            <select id="f-grade" class="form-control">
              <option value="">—</option>
              <option value="9">9th</option>
              <option value="10">10th</option>
              <option value="11">11th</option>
              <option value="12">12th</option>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Email</label>
          <input type="email" id="f-email" class="form-control" placeholder="student@gmail.com" />
        </div>
        <div class="form-group">
          <label class="form-label">Notes</label>
          <input type="text" id="f-notes" class="form-control" placeholder="Competitive events, committees..." />
        </div>
        <div style="display:flex;gap:0.75rem;justify-content:flex-end;margin-top:0.5rem">
          <button class="btn btn-secondary" id="modal-cancel">Cancel</button>
          <button class="btn btn-primary" id="modal-save">Save Member</button>
        </div>
      </div>
    </div>
  </div>

  <div class="toast" id="toast"></div>
</AdminLayout>

