---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Member Roster" active="roster">
  <div class="page-header">
    <div>
      <h1>Member Roster</h1>
      <p>All Irvington FBLA members for this school year</p>
    </div>
    <div style="display:flex;gap:0.75rem;align-items:center">
      <div class="search-wrap">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" id="search-input" placeholder="Search members..." class="search-input" />
      </div>
      <select id="role-filter" class="filter-select">
        <option value="">All Roles</option>
        <option value="President">President</option>
        <option value="Vice President">Vice President</option>
        <option value="Secretary">Secretary</option>
        <option value="Treasurer">Treasurer</option>
        <option value="Reporter">Reporter</option>
        <option value="Parliamentarian">Parliamentarian</option>
        <option value="Historian">Historian</option>
        <option value="Officer">Officer</option>
        <option value="Member">Member</option>
      </select>
      <button class="btn btn-primary" id="add-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Add Member
      </button>
    </div>
  </div>

  <div class="page-body">
    <div class="roster-stats" id="roster-stats">
      <div class="stat-pill"><span id="stat-total">0</span> total</div>
      <div class="stat-pill officer"><span id="stat-officers">0</span> officers</div>
      <div class="stat-pill member"><span id="stat-members">0</span> members</div>
    </div>

    <div class="card" style="padding:0;overflow:hidden">
      <div id="loading-state" class="empty-state" style="padding:3rem">
        <div class="loading-spinner" style="margin:0 auto 1rem"></div>
        <p>Loading roster...</p>
      </div>
      <div id="empty-state" class="empty-state" style="display:none;padding:3rem">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <p>No members yet. Add your first member to get started.</p>
      </div>
      <table class="roster-table" id="roster-table" style="display:none">
        <thead>
          <tr>
            <th>Name</th>
            <th>Role</th>
            <th>Email</th>
            <th>Grade</th>
            <th>Notes</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="roster-body"></tbody>
      </table>
    </div>
  </div>

  <!-- Add/Edit Modal -->
  <div class="modal-overlay" id="modal">
    <div class="modal">
      <div class="modal-header">
        <h2 id="modal-title">Add Member</h2>
        <button class="modal-close" id="modal-close">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="edit-id" />
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
          <div class="form-group">
            <label class="form-label">First Name *</label>
            <input type="text" id="f-first" class="form-control" placeholder="Avnita" />
          </div>
          <div class="form-group">
            <label class="form-label">Last Name *</label>
            <input type="text" id="f-last" class="form-control" placeholder="Sharma" />
          </div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
          <div class="form-group">
            <label class="form-label">Role *</label>
            <select id="f-role" class="form-control">
              <option value="Member">Member</option>
              <option value="Officer">Officer</option>
              <option value="President">President</option>
              <option value="Vice President">Vice President</option>
              <option value="Secretary">Secretary</option>
              <option value="Treasurer">Treasurer</option>
              <option value="Reporter">Reporter</option>
              <option value="Parliamentarian">Parliamentarian</option>
              <option value="Historian">Historian</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Grade</label>
            <select id="f-grade" class="form-control">
              <option value="">—</option>
              <option value="9">9th</option>
              <option value="10">10th</option>
              <option value="11">11th</option>
              <option value="12">12th</option>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Email</label>
          <input type="email" id="f-email" class="form-control" placeholder="student@student.fuhsd.org" />
        </div>
        <div class="form-group">
          <label class="form-label">Notes</label>
          <input type="text" id="f-notes" class="form-control" placeholder="e.g. competitive events, committee leads..." />
        </div>
        <div style="display:flex;gap:0.75rem;justify-content:flex-end;margin-top:0.5rem">
          <button class="btn btn-secondary" id="modal-cancel">Cancel</button>
          <button class="btn btn-primary" id="modal-save">Save Member</button>
        </div>
      </div>
    </div>
  </div>

  <div class="toast" id="toast"></div>
</AdminLayout>

<script>
const API = '/.netlify/functions/dashboard?resource=roster';
const pw = localStorage.getItem('fbla_admin_pw') || '';
const headers = { 'Content-Type': 'application/json', Authorization: `Bearer ${pw}` };

let allMembers: any[] = [];

const ROLE_COLORS: Record<string, string> = {
  President: 'badge-blue',
  'Vice President': 'badge-purple',
  Secretary: 'badge-teal',
  Treasurer: 'badge-green',
  Reporter: 'badge-orange',
  Parliamentarian: 'badge-orange',
  Historian: 'badge-orange',
  Officer: 'badge-blue',
  Member: 'badge-gray',
};

const OFFICER_ROLES = new Set(['President','Vice President','Secretary','Treasurer','Reporter','Parliamentarian','Historian','Officer']);

function toast(msg: string, type = 'success') {
  const el = document.getElementById('toast')!;
  el.textContent = msg;
  el.className = `toast ${type} show`;
  setTimeout(() => el.classList.remove('show'), 3000);
}

function renderTable(members: any[]) {
  const body = document.getElementById('roster-body')!;
  const table = document.getElementById('roster-table')!;
  const empty = document.getElementById('empty-state')!;

  document.getElementById('stat-total')!.textContent = String(members.length);
  document.getElementById('stat-officers')!.textContent = String(members.filter(m => OFFICER_ROLES.has(m.role)).length);
  document.getElementById('stat-members')!.textContent = String(members.filter(m => m.role === 'Member').length);

  if (members.length === 0) {
    table.style.display = 'none';
    empty.style.display = 'block';
    return;
  }
  empty.style.display = 'none';
  table.style.display = 'table';

  body.innerHTML = members.map(m => `
    <tr>
      <td class="name-cell">
        <div class="avatar">${(m.firstName?.[0] || '?')}${(m.lastName?.[0] || '')}</div>
        <span>${m.firstName} ${m.lastName}</span>
      </td>
      <td><span class="badge ${ROLE_COLORS[m.role] || 'badge-gray'}">${m.role}</span></td>
      <td class="email-cell">${m.email ? `<a href="mailto:${m.email}" class="email-link">${m.email}</a>` : '<span class="dim">—</span>'}</td>
      <td>${m.grade ? `${m.grade}th` : '<span class="dim">—</span>'}</td>
      <td class="notes-cell">${m.notes || '<span class="dim">—</span>'}</td>
      <td class="actions-cell">
        <button class="btn-icon edit-btn" data-id="${m.id}" title="Edit">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        </button>
        <button class="btn-icon delete-btn" data-id="${m.id}" title="Delete">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>
        </button>
      </td>
    </tr>
  `).join('');

  body.querySelectorAll('.edit-btn').forEach(btn => btn.addEventListener('click', () => openEdit((btn as HTMLElement).dataset.id!)));
  body.querySelectorAll('.delete-btn').forEach(btn => btn.addEventListener('click', () => deleteMember((btn as HTMLElement).dataset.id!)));
}

function applyFilters() {
  const q = (document.getElementById('search-input') as HTMLInputElement).value.toLowerCase();
  const role = (document.getElementById('role-filter') as HTMLSelectElement).value;
  const filtered = allMembers.filter(m => {
    const name = `${m.firstName} ${m.lastName}`.toLowerCase();
    const matchQ = !q || name.includes(q) || (m.email || '').toLowerCase().includes(q);
    const matchRole = !role || m.role === role;
    return matchQ && matchRole;
  });
  renderTable(filtered);
}

async function load() {
  const loading = document.getElementById('loading-state')!;
  try {
    const res = await fetch(API, { headers });
    const data = await res.json();
    allMembers = (data.items || []).sort((a: any, b: any) => {
      const aOff = OFFICER_ROLES.has(a.role);
      const bOff = OFFICER_ROLES.has(b.role);
      if (aOff !== bOff) return aOff ? -1 : 1;
      return `${a.lastName}${a.firstName}`.localeCompare(`${b.lastName}${b.firstName}`);
    });
    loading.style.display = 'none';
    applyFilters();
  } catch {
    loading.innerHTML = '<p style="color:#dc2626">Failed to load roster.</p>';
  }
}

// Modal
const modal = document.getElementById('modal')!;
const editId = document.getElementById('edit-id') as HTMLInputElement;
const fFirst = document.getElementById('f-first') as HTMLInputElement;
const fLast = document.getElementById('f-last') as HTMLInputElement;
const fRole = document.getElementById('f-role') as HTMLSelectElement;
const fGrade = document.getElementById('f-grade') as HTMLSelectElement;
const fEmail = document.getElementById('f-email') as HTMLInputElement;
const fNotes = document.getElementById('f-notes') as HTMLInputElement;

function openAdd() {
  editId.value = '';
  fFirst.value = ''; fLast.value = ''; fRole.value = 'Member';
  fGrade.value = ''; fEmail.value = ''; fNotes.value = '';
  document.getElementById('modal-title')!.textContent = 'Add Member';
  modal.classList.add('open');
  fFirst.focus();
}

function openEdit(id: string) {
  const m = allMembers.find(x => x.id === id);
  if (!m) return;
  editId.value = id;
  fFirst.value = m.firstName || '';
  fLast.value = m.lastName || '';
  fRole.value = m.role || 'Member';
  fGrade.value = m.grade || '';
  fEmail.value = m.email || '';
  fNotes.value = m.notes || '';
  document.getElementById('modal-title')!.textContent = 'Edit Member';
  modal.classList.add('open');
}

function closeModal() { modal.classList.remove('open'); }

document.getElementById('add-btn')!.addEventListener('click', openAdd);
document.getElementById('modal-close')!.addEventListener('click', closeModal);
document.getElementById('modal-cancel')!.addEventListener('click', closeModal);
modal.addEventListener('click', e => { if (e.target === modal) closeModal(); });

document.getElementById('modal-save')!.addEventListener('click', async () => {
  const firstName = fFirst.value.trim();
  const lastName = fLast.value.trim();
  if (!firstName || !lastName) { toast('First and last name are required.', 'error'); return; }

  const body = { firstName, lastName, role: fRole.value, grade: fGrade.value, email: fEmail.value.trim(), notes: fNotes.value.trim() };
  const id = editId.value;

  const res = await fetch(API, {
    method: id ? 'PUT' : 'POST',
    headers,
    body: JSON.stringify(id ? { id, ...body } : body),
  });

  if (res.ok) {
    toast(id ? 'Member updated.' : 'Member added.');
    closeModal();
    load();
  } else {
    toast('Something went wrong.', 'error');
  }
});

async function deleteMember(id: string) {
  const m = allMembers.find(x => x.id === id);
  if (!confirm(`Remove ${m?.firstName} ${m?.lastName} from the roster?`)) return;
  const res = await fetch(API, { method: 'DELETE', headers, body: JSON.stringify({ id }) });
  if (res.ok) { toast('Member removed.'); load(); }
  else toast('Delete failed.', 'error');
}

document.getElementById('search-input')!.addEventListener('input', applyFilters);
document.getElementById('role-filter')!.addEventListener('change', applyFilters);

load();
</script>

<style>
.search-wrap {
  position: relative; display: flex; align-items: center;
}
.search-wrap svg { position: absolute; left: 0.75rem; color: #94a3b8; pointer-events: none; }
.search-input {
  padding: 0.55rem 0.875rem 0.55rem 2.25rem;
  border: 1.5px solid #e2e8f0; border-radius: 8px;
  font-size: 0.875rem; color: #1e293b; background: white;
  width: 220px; transition: border-color 0.15s;
}
.search-input:focus { outline: none; border-color: #3b82f6; }
.filter-select {
  padding: 0.55rem 0.875rem; border: 1.5px solid #e2e8f0; border-radius: 8px;
  font-size: 0.875rem; color: #374151; background: white; cursor: pointer;
}
.filter-select:focus { outline: none; border-color: #3b82f6; }

.roster-stats {
  display: flex; gap: 0.5rem; margin-bottom: 1.25rem; flex-wrap: wrap;
}
.stat-pill {
  padding: 0.35rem 0.875rem; border-radius: 50px;
  font-size: 0.8rem; font-weight: 600;
  background: #f1f5f9; color: #475569; border: 1px solid #e2e8f0;
}
.stat-pill span { font-weight: 700; color: #0f172a; }
.stat-pill.officer { background: #eff6ff; color: #1d4ed8; border-color: #bfdbfe; }
.stat-pill.officer span { color: #1e3a8a; }
.stat-pill.member { background: #f0fdf4; color: #15803d; border-color: #bbf7d0; }
.stat-pill.member span { color: #166534; }

.roster-table {
  width: 100%; border-collapse: collapse; font-size: 0.875rem;
}
.roster-table thead tr {
  background: #f8fafc; border-bottom: 1px solid #e2e8f0;
}
.roster-table th {
  padding: 0.875rem 1.25rem; text-align: left;
  font-size: 0.75rem; font-weight: 700; text-transform: uppercase;
  letter-spacing: 0.05em; color: #64748b;
}
.roster-table tbody tr {
  border-bottom: 1px solid #f1f5f9; transition: background 0.1s;
}
.roster-table tbody tr:last-child { border-bottom: none; }
.roster-table tbody tr:hover { background: #f8fafc; }
.roster-table td { padding: 0.875rem 1.25rem; color: #374151; }

.name-cell { display: flex; align-items: center; gap: 0.75rem; }
.avatar {
  width: 34px; height: 34px; border-radius: 50%;
  background: linear-gradient(135deg, #1e3a8a, #3b82f6);
  color: white; font-size: 0.72rem; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; letter-spacing: 0.02em;
}
.email-link { color: #3b82f6; text-decoration: none; }
.email-link:hover { text-decoration: underline; }
.email-cell { max-width: 240px; }
.notes-cell { max-width: 200px; color: #64748b; font-size: 0.82rem; }
.actions-cell { white-space: nowrap; }
.dim { color: #d1d5db; }

.delete-btn:hover { border-color: #fecaca !important; color: #dc2626 !important; background: #fef2f2 !important; }

@media (max-width: 900px) {
  .page-header { flex-direction: column; align-items: flex-start; gap: 1rem; }
  .page-header > div:last-child { flex-wrap: wrap; }
  .search-input { width: 160px; }
  .email-cell, .notes-cell { display: none; }
}
</style>
