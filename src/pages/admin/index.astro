---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Admin Dashboard | Irvington FBLA">
  <section class="admin-hero">
    <div class="container">
      <div class="hero-content">
        <span class="badge">Officers Only</span>
        <h1>Admin Dashboard</h1>
        <p>Manage your Irvington FBLA website tools</p>
      </div>
    </div>
  </section>

  <section class="admin-section">
    <div class="container">
      <div id="auth-gate" class="auth-gate">
        <div class="auth-card">
          <div class="lock-icon">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </div>
          <h2>Officer Login</h2>
          <p>Enter the officer password to access admin tools. You only need to do this once per device.</p>
          <div id="auth-error" style="display:none; background:#fef2f2; border:1px solid #fecaca; color:#dc2626; padding:0.75rem 1rem; border-radius:10px; font-size:0.9rem; margin-bottom:1rem;"></div>
          <div class="token-input-group">
            <input type="password" id="token-input" placeholder="Enter officer password..." autocomplete="off" />
            <button id="save-token-btn" class="btn-primary">Unlock</button>
          </div>
          <p class="token-hint">Ask your president or webmaster for the password.</p>
        </div>
      </div>

      <div id="dashboard" class="dashboard" style="display: none;">
        <div class="dashboard-header">
          <p class="welcome-text">You're authenticated. Choose a tool below.</p>
          <button id="logout-btn" class="btn-secondary-small">Log Out</button>
        </div>
        <div class="tools-grid">
          <a href="/admin/dashboard" class="tool-card featured">
            <div class="tool-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
            </div>
            <h3>Officer Dashboard</h3>
            <p>Full dashboard: calendar, tasks, minutes, budget & more</p>
            <span class="tool-badge">New</span>
          </a>
          <a href="/admin/calendar" class="tool-card">
            <div class="tool-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </div>
            <h3>Master Calendar</h3>
            <p>All FBLA events, meetings, and conferences in one place</p>
          </a>
          <a href="/admin/tasks" class="tool-card">
            <div class="tool-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
            </div>
            <h3>Task Board</h3>
            <p>Assign tasks to officers, track deadlines, and manage strikes</p>
          </a>
          <a href="/admin/budget" class="tool-card">
            <div class="tool-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
            <h3>Budget Dashboard</h3>
            <p>Track spending by category, syncs with Google Sheets</p>
          </a>
          <a href="/admin/edit-website" class="tool-card">
            <div class="tool-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            </div>
            <h3>Edit Website</h3>
            <p>Manage resource links, gallery, and public page content</p>
          </a>
          <a href="/admin/roster" class="tool-card">
            <div class="tool-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <h3>Member Roster</h3>
            <p>All Irvington FBLA members — names, roles, and contact info</p>
          </a>
          <a href="/admin/link-generator" class="tool-card">
            <div class="tool-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
              </svg>
            </div>
            <h3>Link Generator</h3>
            <p>Create short redirect links like irvingtonfbla.org/your-slug</p>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const password = localStorage.getItem('fbla_admin_pw');
  const authGate = document.getElementById('auth-gate')!;
  const dashboard = document.getElementById('dashboard')!;
  const tokenInput = document.getElementById('token-input') as HTMLInputElement;
  const saveBtn = document.getElementById('save-token-btn')!;
  const logoutBtn = document.getElementById('logout-btn')!;
  const authError = document.getElementById('auth-error')!;

  function showDashboard() {
    authGate.style.display = 'none';
    dashboard.style.display = 'block';
  }

  function showAuth() {
    authGate.style.display = 'flex';
    dashboard.style.display = 'none';
  }

  // Auto-authenticate on localhost so dev testing doesn't require a working function call
  const isLocalDev = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
  if (isLocalDev) {
    localStorage.setItem('fbla_admin_pw', 'sigmafbla67');
    showDashboard();
  } else if (password) {
    showDashboard();
  }

  saveBtn.addEventListener('click', async () => {
    const val = tokenInput.value.trim();
    if (!val) return;

    // Validate password by making a test request to the function
    saveBtn.textContent = 'Checking...';
    (saveBtn as HTMLButtonElement).disabled = true;
    authError.style.display = 'none';

    try {
      const res = await fetch('/.netlify/functions/dashboard?resource=events', {
        headers: { Authorization: `Bearer ${val}` },
      });

      if (res.ok) {
        localStorage.setItem('fbla_admin_pw', val);
        showDashboard();
      } else {
        authError.textContent = 'Wrong password. Ask your president or webmaster for the correct one.';
        authError.style.display = 'block';
      }
    } catch {
      authError.textContent = 'Could not connect. Try again in a moment.';
      authError.style.display = 'block';
    } finally {
      saveBtn.textContent = 'Unlock';
      (saveBtn as HTMLButtonElement).disabled = false;
    }
  });

  tokenInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') saveBtn.click();
  });

  logoutBtn.addEventListener('click', () => {
    localStorage.removeItem('fbla_admin_pw');
    tokenInput.value = '';
    showAuth();
  });
</script>

<style>
  .admin-hero {
    background: linear-gradient(135deg, #1e3a8a 0%, #1e40af 50%, #3b82f6 100%);
    padding: 8rem 2rem 4rem;
    text-align: center;
    color: white;
  }

  .hero-content {
    max-width: 600px;
    margin: 0 auto;
  }

  .badge {
    display: inline-block;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.3);
    padding: 0.4rem 1.2rem;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }

  .admin-hero h1 {
    font-size: 3rem;
    font-weight: 800;
    margin: 0 0 1rem;
  }

  .admin-hero p {
    font-size: 1.2rem;
    opacity: 0.9;
    margin: 0;
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .admin-section {
    padding: 4rem 0;
  }

  /* Auth Gate */
  .auth-gate {
    display: flex;
    justify-content: center;
  }

  .auth-card {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 20px;
    padding: 3rem;
    text-align: center;
    max-width: 480px;
    width: 100%;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
  }

  .lock-icon {
    color: #1e3a8a;
    margin-bottom: 1.5rem;
  }

  .auth-card h2 {
    font-size: 1.8rem;
    color: #1e3a8a;
    margin: 0 0 0.75rem;
  }

  .auth-card > p {
    color: #6b7280;
    margin: 0 0 2rem;
    line-height: 1.6;
  }

  .token-input-group {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .token-input-group input {
    flex: 1;
    padding: 0.85rem 1.2rem;
    border: 2px solid #e5e7eb;
    border-radius: 12px;
    font-size: 1rem;
    font-family: inherit;
    transition: border-color 0.3s;
  }

  .token-input-group input:focus {
    outline: none;
    border-color: #3b82f6;
  }

  .btn-primary {
    background: #1e3a8a;
    color: white;
    border: none;
    padding: 0.85rem 2rem;
    border-radius: 12px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s;
    font-family: inherit;
  }

  .btn-primary:hover {
    background: #1e40af;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(30, 58, 138, 0.3);
  }

  .token-hint {
    font-size: 0.85rem;
    color: #9ca3af;
    margin: 0;
  }

  /* Dashboard */
  .dashboard-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
  }

  .welcome-text {
    color: #6b7280;
    margin: 0;
    font-size: 1.05rem;
  }

  .btn-secondary-small {
    background: none;
    border: 1px solid #d1d5db;
    padding: 0.5rem 1.2rem;
    border-radius: 8px;
    font-size: 0.85rem;
    color: #6b7280;
    cursor: pointer;
    transition: all 0.3s;
    font-family: inherit;
  }

  .btn-secondary-small:hover {
    border-color: #ef4444;
    color: #ef4444;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  .tool-card {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    padding: 1.75rem;
    text-decoration: none;
    color: inherit;
    transition: all 0.25s;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    position: relative;
    overflow: hidden;
  }

  .tool-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.1);
    border-color: #3b82f6;
  }

  .tool-card.featured {
    border-color: #1e3a8a;
    background: linear-gradient(135deg, #1e3a8a 0%, #1e40af 100%);
    color: white;
  }

  .tool-card.featured .tool-icon { color: rgba(255,255,255,0.9); }
  .tool-card.featured h3 { color: white; }
  .tool-card.featured p { color: rgba(255,255,255,0.75); }

  .tool-badge {
    position: absolute; top: 1rem; right: 1rem;
    background: #f97316; color: white;
    font-size: 0.7rem; font-weight: 700; padding: 0.2rem 0.6rem;
    border-radius: 50px; text-transform: uppercase; letter-spacing: 0.05em;
  }

  .tool-icon {
    color: #1e3a8a;
    margin-bottom: 1rem;
  }

  .tool-card h3 {
    font-size: 1.15rem;
    color: #1e3a8a;
    margin: 0 0 0.4rem;
    font-weight: 700;
  }

  .tool-card p {
    color: #6b7280;
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    .admin-hero {
      padding: 7rem 1.5rem 3rem;
    }

    .admin-hero h1 {
      font-size: 2.2rem;
    }

    .auth-card {
      padding: 2rem;
    }

    .token-input-group {
      flex-direction: column;
    }

    .dashboard-header {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
  }
</style>
