---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Task Board" active="tasks">
  <div class="page-header">
    <div>
      <h1>Task Board</h1>
      <p>Assign tasks, track deadlines, manage officer accountability</p>
    </div>
    <div style="display:flex;gap:0.75rem;align-items:center;flex-wrap:wrap">
      <div class="view-toggle">
        <button class="view-btn active" id="btn-cards">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
          Cards
        </button>
        <button class="view-btn" id="btn-table">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="9" x2="9" y2="21"/></svg>
          Table
        </button>
      </div>
      <select id="filter-officer" class="filter-select">
        <option value="">All Officers</option>
      </select>
      <select id="filter-status" class="filter-select">
        <option value="">All Status</option>
        <option value="not-started">Not Started</option>
        <option value="in-progress">In Progress</option>
        <option value="done">Done</option>
        <option value="missed">Missed</option>
      </select>
      <button class="btn btn-primary" id="add-task-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Add Task
      </button>
    </div>
  </div>

  <div class="page-body">

    <!-- CARDS VIEW (default) -->
    <div id="cards-view">
      <!-- Dept tab bar -->
      <div class="dept-tab-bar" id="dept-tab-bar">
        <button class="dept-tab active" data-dept="">All</button>
      </div>

      <!-- Summary bar -->
      <div class="summary-bar" id="summary-bar" style="display:none"></div>

      <!-- Loading -->
      <div id="card-loading" class="empty-state" style="padding:4rem">
        <div class="loading-spinner" style="margin:0 auto 1rem"></div>
        <p>Loading tasks…</p>
      </div>

      <!-- Card content -->
      <div id="card-content"></div>
    </div>

    <!-- TABLE VIEW (secondary) -->
    <div id="table-view" style="display:none">
      <div class="card" style="padding:0;overflow:hidden">
        <div id="task-empty" class="empty-state" style="display:none;padding:3rem">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="opacity:0.3;margin-bottom:1rem"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
          <p>No tasks match your filters.</p>
        </div>
        <div class="table-scroll" id="table-wrap">
          <table class="task-table" id="task-table">
            <thead>
              <tr>
                <th class="th-status"></th>
                <th>Deadline</th>
                <th>Task</th>
                <th>Description</th>
                <th>Lead Officer</th>
                <th>Other Officers</th>
                <th>Dept</th>
                <th></th>
              </tr>
            </thead>
            <tbody id="task-tbody"></tbody>
          </table>
        </div>
      </div>
    </div>

  </div>

  <!-- Add/Edit Modal -->
  <div class="modal-overlay" id="task-modal">
    <div class="modal" style="max-width:580px">
      <div class="modal-header">
        <h2 id="modal-title">Add Task</h2>
        <button class="modal-close" id="modal-close">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="f-id" />
        <div class="form-group">
          <label class="form-label">Task *</label>
          <input type="text" id="f-title" class="form-control" placeholder="e.g. Design Minicon flyer" />
        </div>
        <div class="form-group">
          <label class="form-label">Description <span style="color:#94a3b8;font-weight:400">(include times if relevant)</span></label>
          <textarea id="f-desc" class="form-control" rows="2" placeholder="What needs to be done? Add specific times, context, links..."></textarea>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
          <div class="form-group">
            <label class="form-label">Lead Officer</label>
            <input type="text" id="f-lead" class="form-control" placeholder="Name" list="officer-list" autocomplete="off" />
          </div>
          <div class="form-group">
            <label class="form-label">Other Officers</label>
            <input type="text" id="f-others" class="form-control" placeholder="Name, Name..." list="officer-list" autocomplete="off" />
          </div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:1rem">
          <div class="form-group">
            <label class="form-label">Deadline</label>
            <input type="date" id="f-deadline" class="form-control" />
          </div>
          <div class="form-group">
            <label class="form-label">Location</label>
            <select id="f-location" class="form-control">
              <option value="">—</option>
              <option value="In-person">In-person</option>
              <option value="Online">Online</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Status</label>
            <select id="f-status" class="form-control">
              <option value="not-started">Not Started</option>
              <option value="in-progress">In Progress</option>
              <option value="done">Done</option>
              <option value="missed">Missed</option>
            </select>
          </div>
        </div>
        <datalist id="officer-list"></datalist>
        <div style="display:flex;gap:0.75rem;justify-content:flex-end;align-items:center;margin-top:0.5rem">
          <button class="btn btn-danger btn-sm" id="delete-btn" style="display:none;margin-right:auto">Delete Task</button>
          <button class="btn btn-secondary" id="modal-cancel">Cancel</button>
          <button class="btn btn-primary" id="save-btn">Save Task</button>
        </div>
      </div>
    </div>
  </div>

  <div class="toast" id="toast"></div>
</AdminLayout>

<script>
const API = '/.netlify/functions/dashboard';
const pw = () => localStorage.getItem('fbla_admin_pw') || '';
const h = () => ({ 'Content-Type': 'application/json', Authorization: `Bearer ${pw()}` });

let allTasks: any[] = [];
let allStrikes: any[] = [];
let editingId: string | null = null;
let currentView = 'cards';
let sheetTabs: string[] = [];
let activeDept = '';

const STATUS_LABEL: Record<string,string> = { 'not-started': 'Not Started', 'in-progress': 'In Progress', done: 'Done', missed: 'Missed' };
const STATUS_DOT: Record<string,string>  = { 'not-started': '#94a3b8', 'in-progress': '#f59e0b', done: '#22c55e', missed: '#ef4444' };
const ROW_BG: Record<string,string>  = { 'not-started': '#fff', 'in-progress': '#fffbeb', done: '#f0fdf4', missed: '#fef2f2' };

function fmt(d: string) {
  if (!d) return '—';
  if (/^\d{1,2}\/\d{1,2}(\/\d{2,4})?$/.test(d)) return d.split('/').slice(0,2).join('/');
  const dt = new Date(d + 'T12:00:00');
  if (isNaN(dt.getTime())) return d;
  return `${dt.getMonth()+1}/${dt.getDate()}`;
}
function fmtLong(d: string) {
  if (!d) return '';
  if (/^\d{1,2}\/\d{1,2}(\/\d{2,4})?$/.test(d)) {
    const [m, day] = d.split('/');
    return new Date(new Date().getFullYear(), +m - 1, +day).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
  }
  const dt = new Date(d + 'T12:00:00');
  if (isNaN(dt.getTime())) return d;
  return dt.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
}
function isOverdue(deadline: string, status: string) {
  if (!deadline || status === 'done' || status === 'missed') return false;
  return new Date(deadline + 'T23:59:59') < new Date();
}
function toast(msg: string, type = 'success') {
  const el = document.getElementById('toast')!;
  el.textContent = msg; el.className = `toast ${type} show`;
  setTimeout(() => el.classList.remove('show'), 3000);
}

// ── Card rendering ───────────────────────────────────────────────
function buildCard(t: any): string {
  const lead   = t.leadOfficer || t.assignedTo?.[0] || '';
  const others: string[] = t.otherOfficers?.length ? t.otherOfficers : (t.assignedTo?.slice(1) || []);
  const od     = isOverdue(t.deadline, t.status);
  const fromSheets = t.source === 'sheets';
  const dl     = t.deadline ? fmtLong(t.deadline) : '';

  const statusColors: Record<string,string> = {
    'not-started': 'status-ns',
    'in-progress': 'status-ip',
    done: 'status-done',
    missed: 'status-missed',
  };
  const cls = statusColors[t.status] || 'status-ns';

  return `<div class="tcard ${cls}" data-id="${t.id}">
    <div class="tcard-top">
      <span class="tcard-status">
        <span class="tcard-dot" style="background:${STATUS_DOT[t.status]||'#94a3b8'}"></span>
        ${STATUS_LABEL[t.status] || 'Unknown'}
      </span>
      ${dl ? `<span class="tcard-dl${od ? ' od' : ''}">${od ? '⚠ ' : ''}${dl}</span>` : ''}
    </div>

    <div class="tcard-title">${t.title}</div>
    ${t.description ? `<div class="tcard-desc">${t.description}</div>` : ''}

    <div class="tcard-foot">
      <div class="tcard-officers">
        ${lead ? `<span class="o-chip">${lead}</span>` : ''}
        ${others.slice(0,2).map((n: string) => `<span class="o-chip sec">${n}</span>`).join('')}
        ${others.length > 2 ? `<span class="o-chip sec">+${others.length-2}</span>` : ''}
      </div>
      <div class="tcard-actions">
        ${t.location === 'Online' ? `<span class="loc-badge online">Online</span>` : t.location ? `<span class="loc-badge inperson">In-person</span>` : ''}
        ${fromSheets
          ? `<span class="src-badge">Sheets</span>`
          : `<button class="card-edit-btn" data-id="${t.id}" title="Edit">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
             </button>`
        }
      </div>
    </div>
  </div>`;
}

function buildGrid(tasks: any[]): string {
  if (!tasks.length) return '<div class="card-empty">No tasks match the current filters.</div>';
  const sorted = [...tasks].sort((a, b) => {
    const pa = a.status === 'missed' ? 0 : a.status === 'in-progress' ? 1 : a.status === 'not-started' ? 2 : 3;
    const pb = b.status === 'missed' ? 0 : b.status === 'in-progress' ? 1 : b.status === 'not-started' ? 2 : 3;
    if (pa !== pb) return pa - pb;
    if (a.deadline && b.deadline) return String(a.deadline).localeCompare(String(b.deadline));
    return a.deadline ? -1 : 1;
  });
  return `<div class="card-grid">${sorted.map(buildCard).join('')}</div>`;
}

function deptStats(tasks: any[]) {
  const done    = tasks.filter(t => t.status === 'done').length;
  const missed  = tasks.filter(t => t.status === 'missed').length;
  const inProg  = tasks.filter(t => t.status === 'in-progress').length;
  const pct     = tasks.length ? Math.round((done / tasks.length) * 100) : 0;
  return { done, missed, inProg, total: tasks.length, pct };
}

function buildSummaryBar(tasks: any[]): string {
  const { done, missed, inProg, total, pct } = deptStats(tasks);
  return `<div class="summary-bar-inner">
    <div class="sb-stat"><span class="sb-n">${total}</span><span class="sb-l">Total</span></div>
    <div class="sb-stat"><span class="sb-n green">${done}</span><span class="sb-l">Done</span></div>
    <div class="sb-stat"><span class="sb-n amber">${inProg}</span><span class="sb-l">In Progress</span></div>
    <div class="sb-stat"><span class="sb-n red">${missed}</span><span class="sb-l">Missed</span></div>
    <div class="sb-progress">
      <div class="sb-bar"><div class="sb-fill" style="width:${pct}%"></div></div>
      <span class="sb-pct">${pct}% done</span>
    </div>
  </div>`;
}

function renderCards(tasks: any[]) {
  document.getElementById('card-loading')!.style.display = 'none';
  const content = document.getElementById('card-content')!;
  const summaryEl = document.getElementById('summary-bar')!;

  if (activeDept) {
    // Single dept: flat grid with summary bar
    summaryEl.style.display = '';
    summaryEl.innerHTML = buildSummaryBar(tasks);
    content.innerHTML = buildGrid(tasks);
  } else {
    // All depts: group by department
    summaryEl.style.display = 'none';

    const groups: Record<string, any[]> = {};
    const noTab: any[] = [];
    tasks.forEach(t => {
      if (t.tab) { groups[t.tab] = groups[t.tab] || []; groups[t.tab].push(t); }
      else { noTab.push(t); }
    });

    if (noTab.length) groups['General'] = noTab;

    if (!Object.keys(groups).length) {
      content.innerHTML = '<div class="card-empty">No tasks found.</div>';
      return;
    }

    // Order sections by sheet tab order first, then General
    const orderedKeys = [
      ...sheetTabs.filter(t => groups[t]),
      ...Object.keys(groups).filter(k => !sheetTabs.includes(k)),
    ];

    content.innerHTML = orderedKeys.map(dept => {
      const dt = groups[dept];
      const { done, missed, total, pct } = deptStats(dt);
      return `<div class="dept-section">
        <div class="dept-hdr">
          <div class="dept-hdr-left">
            <span class="dept-hdr-name">${dept}</span>
            <div class="dept-hdr-pills">
              <span class="dpill total">${total} tasks</span>
              ${done ? `<span class="dpill green">${done} done</span>` : ''}
              ${missed ? `<span class="dpill red">${missed} missed</span>` : ''}
            </div>
          </div>
          <div class="dept-hdr-right">
            <div class="dept-bar"><div class="dept-bar-fill" style="width:${pct}%"></div></div>
            <span class="dept-pct">${pct}%</span>
          </div>
        </div>
        ${buildGrid(dt)}
      </div>`;
    }).join('');
  }

  // Wire edit buttons
  content.querySelectorAll('.card-edit-btn').forEach(btn => {
    btn.addEventListener('click', () => openEdit((btn as HTMLElement).dataset.id!));
  });
}

// ── Table rendering ──────────────────────────────────────────────
function renderTableView(tasks: any[]) {
  const empty = document.getElementById('task-empty')!;
  const wrap  = document.getElementById('table-wrap')!;
  const tbody = document.getElementById('task-tbody')!;

  if (!tasks.length) { empty.style.display = 'block'; wrap.style.display = 'none'; return; }
  empty.style.display = 'none'; wrap.style.display = '';

  const sorted = [...tasks].sort((a, b) => {
    if (a.deadline && b.deadline) return String(a.deadline).localeCompare(String(b.deadline));
    return a.deadline ? -1 : 1;
  });

  const RC: Record<string,string> = { 'not-started': 'row-ns', 'in-progress': 'row-ip', done: 'row-done', missed: 'row-missed' };

  tbody.innerHTML = sorted.map(t => {
    const lead    = t.leadOfficer || t.assignedTo?.[0] || '';
    const others: string[] = t.otherOfficers?.length ? t.otherOfficers : (t.assignedTo?.slice(1) || []);
    const od      = isOverdue(t.deadline, t.status);
    const from    = t.source === 'sheets';
    return `<tr class="${RC[t.status]||'row-ns'}" data-id="${t.id}">
      <td class="status-bar"></td>
      <td class="deadline-col${od ? ' overdue' : ''}">${t.deadline ? fmtLong(t.deadline) : '—'}</td>
      <td class="task-col"><span class="task-name">${t.title}</span></td>
      <td class="desc-col">${t.description || '<span class="dim">—</span>'}</td>
      <td class="officer-col">${lead ? `<span class="o-chip">${lead}</span>` : '<span class="dim">—</span>'}</td>
      <td class="officer-col">${others.map((n: string) => `<span class="o-chip sec">${n}</span>`).join('') || '<span class="dim">—</span>'}</td>
      <td class="dept-col">${t.tab ? `<span class="dept-tag">${t.tab}</span>` : '<span class="dim">—</span>'}</td>
      <td class="actions-col">
        ${from
          ? `<span class="src-badge">Sheets</span>`
          : `<select class="status-select" data-id="${t.id}">
              ${['not-started','in-progress','done','missed'].map(s => `<option value="${s}"${s===t.status?' selected':''}>${STATUS_LABEL[s]}</option>`).join('')}
            </select>
            <button class="btn-icon edit-btn" data-id="${t.id}">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            </button>`}
      </td>
    </tr>`;
  }).join('');

  tbody.querySelectorAll('.status-select').forEach(sel => {
    sel.addEventListener('change', async e => {
      const el = e.target as HTMLSelectElement;
      const task = allTasks.find(t => t.id === el.dataset.id);
      if (task) await updateStatus(task, el.value);
    });
  });
  tbody.querySelectorAll('.edit-btn').forEach(btn => {
    btn.addEventListener('click', () => openEdit((btn as HTMLElement).dataset.id!));
  });
}

// ── Filters + render ─────────────────────────────────────────────
function getFiltered() {
  const statusF  = (document.getElementById('filter-status') as HTMLSelectElement).value;
  const officerF = (document.getElementById('filter-officer') as HTMLSelectElement).value;
  return allTasks.filter(t => {
    if (statusF && t.status !== statusF) return false;
    if (activeDept && t.tab !== activeDept) return false;
    if (officerF) {
      const lead    = t.leadOfficer || t.assignedTo?.[0] || '';
      const others: string[] = t.otherOfficers || t.assignedTo?.slice(1) || [];
      if (lead !== officerF && !others.includes(officerF)) return false;
    }
    return true;
  });
}

function render() {
  const tasks = getFiltered();
  if (currentView === 'cards') renderCards(tasks);
  else renderTableView(tasks);
}

// ── Dept tabs ────────────────────────────────────────────────────
function buildDeptTabs() {
  const bar = document.getElementById('dept-tab-bar')!;
  const tabs = ['', ...sheetTabs];
  bar.innerHTML = tabs.map(t =>
    `<button class="dept-tab${t === activeDept ? ' active' : ''}" data-dept="${t}">${t || 'All'}</button>`
  ).join('');
  bar.querySelectorAll('.dept-tab').forEach(btn => {
    btn.addEventListener('click', () => {
      activeDept = (btn as HTMLElement).dataset.dept!;
      bar.querySelectorAll('.dept-tab').forEach(b => b.classList.toggle('active', b === btn));
      render();
    });
  });
}

// ── Officer filter ───────────────────────────────────────────────
function populateOfficerFilter() {
  const sel   = document.getElementById('filter-officer') as HTMLSelectElement;
  const names = new Set<string>();
  allTasks.forEach(t => {
    const lead = t.leadOfficer || t.assignedTo?.[0];
    if (lead) names.add(lead);
    (t.otherOfficers || t.assignedTo?.slice(1) || []).forEach((n: string) => n && names.add(n));
  });
  const existing = Array.from(sel.options).slice(1).map(o => o.value);
  names.forEach(n => {
    if (!existing.includes(n)) {
      const opt = document.createElement('option');
      opt.value = n; opt.textContent = n;
      sel.appendChild(opt);
    }
  });
}

// ── Status update + strikes ──────────────────────────────────────
async function updateStatus(task: any, newStatus: string) {
  await fetch(`${API}?resource=tasks`, {
    method: 'PUT', headers: h(),
    body: JSON.stringify({ id: task.id, status: newStatus }),
  });
  if (newStatus === 'missed') {
    const lead    = task.leadOfficer || task.assignedTo?.[0];
    const others: string[] = task.otherOfficers || task.assignedTo?.slice(1) || [];
    const everyone = [lead, ...others].filter(Boolean);
    if (everyone.length > 0) {
      const ok = confirm(`Task "${task.title}" marked Missed.\nAdd strikes to: ${everyone.join(', ')}?`);
      if (ok) { for (const name of everyone) await recordStrike(name, task); toast('Strikes recorded'); }
    }
  }
  await loadData();
  toast('Status updated');
}

async function recordStrike(name: string, task: any) {
  const existing = allStrikes.find(s => s.officerName === name);
  const entry = { taskId: task.id, taskTitle: task.title, date: new Date().toISOString().slice(0,10) };
  if (existing) {
    await fetch(`${API}?resource=strikes`, {
      method: 'PUT', headers: h(),
      body: JSON.stringify({ id: existing.id, count: existing.count + 1, history: [...(existing.history||[]), entry] }),
    });
  } else {
    await fetch(`${API}?resource=strikes`, {
      method: 'POST', headers: h(),
      body: JSON.stringify({ officerName: name, count: 1, history: [entry] }),
    });
  }
}

// ── Load data ────────────────────────────────────────────────────
async function loadData() {
  const [tr, sr, sheetRes] = await Promise.all([
    fetch(`${API}?resource=tasks`, { headers: h() }),
    fetch(`${API}?resource=strikes`, { headers: h() }),
    fetch('/.netlify/functions/sheets-tasks', { headers: h() }).catch(() => null),
  ]);
  const blobTasks = (await tr.json()).items || [];
  allStrikes = (await sr.json()).items || [];

  let sheetData: any = null;
  try { if (sheetRes?.ok) sheetData = await sheetRes.json(); } catch {}

  if (sheetData?.tasks?.length) {
    sheetTabs = sheetData.tabs || [];
    const blobIds = new Set(blobTasks.map((t: any) => t.id));
    allTasks = [...sheetData.tasks, ...blobTasks.filter((t: any) => !blobIds.has(t.id))];
  } else {
    sheetTabs = [];
    allTasks = blobTasks;
  }

  buildDeptTabs();
  populateOfficerFilter();
  render();
}

// ── Roster autocomplete ──────────────────────────────────────────
async function loadRosterAutocomplete() {
  try {
    const res  = await fetch(`${API}?resource=roster`, { headers: h() });
    const data = await res.json();
    const dl   = document.getElementById('officer-list')!;
    (data.items || []).forEach((m: any) => {
      const opt = document.createElement('option');
      opt.value = `${m.firstName} ${m.lastName}`;
      dl.appendChild(opt);
    });
  } catch {}
}

// ── Modal ────────────────────────────────────────────────────────
const modal = document.getElementById('task-modal')!;

function openAdd() {
  editingId = null;
  document.getElementById('modal-title')!.textContent = 'Add Task';
  document.getElementById('delete-btn')!.style.display = 'none';
  (document.getElementById('f-id') as HTMLInputElement).value = '';
  (document.getElementById('f-title') as HTMLInputElement).value = '';
  (document.getElementById('f-desc') as HTMLTextAreaElement).value = '';
  (document.getElementById('f-lead') as HTMLInputElement).value = '';
  (document.getElementById('f-others') as HTMLInputElement).value = '';
  (document.getElementById('f-deadline') as HTMLInputElement).value = '';
  (document.getElementById('f-location') as HTMLSelectElement).value = '';
  (document.getElementById('f-status') as HTMLSelectElement).value = 'not-started';
  modal.classList.add('open');
  (document.getElementById('f-title') as HTMLInputElement).focus();
}

function openEdit(id: string) {
  const t = allTasks.find(x => x.id === id);
  if (!t) return;
  editingId = id;
  document.getElementById('modal-title')!.textContent = 'Edit Task';
  document.getElementById('delete-btn')!.style.display = '';
  (document.getElementById('f-id') as HTMLInputElement).value = id;
  (document.getElementById('f-title') as HTMLInputElement).value = t.title || '';
  (document.getElementById('f-desc') as HTMLTextAreaElement).value = t.description || '';
  (document.getElementById('f-lead') as HTMLInputElement).value = t.leadOfficer || t.assignedTo?.[0] || '';
  (document.getElementById('f-others') as HTMLInputElement).value = (t.otherOfficers || t.assignedTo?.slice(1) || []).join(', ');
  (document.getElementById('f-deadline') as HTMLInputElement).value = t.deadline?.slice(0,10) || '';
  (document.getElementById('f-location') as HTMLSelectElement).value = t.location || '';
  (document.getElementById('f-status') as HTMLSelectElement).value = t.status || 'not-started';
  modal.classList.add('open');
}

function closeModal() { modal.classList.remove('open'); }

document.getElementById('add-task-btn')!.addEventListener('click', openAdd);
document.getElementById('modal-close')!.addEventListener('click', closeModal);
document.getElementById('modal-cancel')!.addEventListener('click', closeModal);
modal.addEventListener('click', e => { if (e.target === modal) closeModal(); });

document.getElementById('save-btn')!.addEventListener('click', async () => {
  const title = (document.getElementById('f-title') as HTMLInputElement).value.trim();
  if (!title) { toast('Task name is required', 'error'); return; }
  const leadOfficer   = (document.getElementById('f-lead') as HTMLInputElement).value.trim();
  const othersRaw     = (document.getElementById('f-others') as HTMLInputElement).value;
  const otherOfficers = othersRaw.split(',').map(s => s.trim()).filter(Boolean);
  const payload: any  = {
    title,
    description: (document.getElementById('f-desc') as HTMLTextAreaElement).value.trim() || null,
    leadOfficer: leadOfficer || null,
    otherOfficers,
    deadline: (document.getElementById('f-deadline') as HTMLInputElement).value || null,
    location: (document.getElementById('f-location') as HTMLSelectElement).value || null,
    status: (document.getElementById('f-status') as HTMLSelectElement).value,
  };
  if (!editingId) payload.dateAdded = new Date().toISOString().slice(0, 10);
  const btn = document.getElementById('save-btn') as HTMLButtonElement;
  btn.textContent = 'Saving…'; btn.disabled = true;
  try {
    if (editingId) {
      await fetch(`${API}?resource=tasks`, { method: 'PUT', headers: h(), body: JSON.stringify({ id: editingId, ...payload }) });
    } else {
      await fetch(`${API}?resource=tasks`, { method: 'POST', headers: h(), body: JSON.stringify(payload) });
    }
    await loadData(); closeModal(); toast(editingId ? 'Task updated' : 'Task added');
  } catch { toast('Failed to save', 'error'); }
  finally { btn.textContent = 'Save Task'; btn.disabled = false; }
});

document.getElementById('delete-btn')!.addEventListener('click', async () => {
  if (!editingId || !confirm('Delete this task?')) return;
  await fetch(`${API}?resource=tasks`, { method: 'DELETE', headers: h(), body: JSON.stringify({ id: editingId }) });
  await loadData(); closeModal(); toast('Task deleted');
});

// ── View toggle ──────────────────────────────────────────────────
document.getElementById('btn-cards')!.addEventListener('click', () => {
  currentView = 'cards';
  document.getElementById('cards-view')!.style.display = '';
  document.getElementById('table-view')!.style.display = 'none';
  document.getElementById('btn-cards')!.classList.add('active');
  document.getElementById('btn-table')!.classList.remove('active');
  render();
});
document.getElementById('btn-table')!.addEventListener('click', () => {
  currentView = 'table';
  document.getElementById('cards-view')!.style.display = 'none';
  document.getElementById('table-view')!.style.display = '';
  document.getElementById('btn-table')!.classList.add('active');
  document.getElementById('btn-cards')!.classList.remove('active');
  render();
});

document.getElementById('filter-status')!.addEventListener('change', render);
document.getElementById('filter-officer')!.addEventListener('change', render);

loadData();
loadRosterAutocomplete();
</script>

