---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Budget" active="budget">
  <div class="page-header">
    <div>
      <h1>Budget Dashboard</h1>
      <p>Track chapter spending — synced with Google Sheets</p>
    </div>
    <div style="display:flex;gap:0.75rem;align-items:center">
      <span class="sync-status" id="sync-status">
        <span class="sync-dot demo"></span>Loading…
      </span>
    </div>
  </div>

  <div class="page-body">
    <!-- Tab bar (shown only if multiple budget tabs exist) -->
    <div id="tab-bar" class="tab-bar" style="display:none"></div>

    <!-- Summary cards -->
    <div class="stats-grid" style="grid-template-columns:repeat(auto-fit,minmax(200px,1fr));margin-bottom:2rem">
      <div class="stat-card">
        <div class="stat-label">Total Budget</div>
        <div class="stat-value" id="stat-total">$0</div>
        <div class="stat-sub">approved allocation</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Total Spent</div>
        <div class="stat-value" id="stat-spent">$0</div>
        <div class="stat-sub">across all categories</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Remaining</div>
        <div class="stat-value green" id="stat-remaining">$0</div>
        <div class="stat-sub" id="stat-pct">0% used</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Categories</div>
        <div class="stat-value" id="stat-cats">0</div>
        <div class="stat-sub">line items tracked</div>
      </div>
    </div>

    <div class="budget-grid">
      <!-- Chart -->
      <div class="card chart-card">
        <h2 class="card-title">Spending by Category</h2>
        <canvas id="budget-chart" height="280"></canvas>
      </div>

      <!-- Category breakdown -->
      <div class="card">
        <h2 class="card-title">Category Breakdown</h2>
        <div id="category-list"></div>
      </div>
    </div>

  </div>
</AdminLayout>

<!-- Load Chart.js from unpkg (already in CSP allowlist) -->
<script src="https://unpkg.com/chart.js@4.4.9/dist/chart.umd.min.js"></script>

<script>
const pw = () => localStorage.getItem('fbla_admin_pw') || '';
const h = () => ({ 'Content-Type': 'application/json', Authorization: `Bearer ${pw()}` });

function fmt(n: number) { return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 0 }); }

// Transform sheets-budget response into chart-friendly categories
function sheetsToCategories(tabData: any): { name: string; budget: number; spent: number }[] {
  if (!tabData) return [];
  return (tabData.expenses || [])
    .filter((e: any) => e.item)
    .map((e: any) => ({ name: e.item, budget: e.estimated || 0, spent: e.actual || 0 }));
}

let budgetRaw: any = null;
let activeTab = '';

async function loadAndRender() {
  const syncEl = document.getElementById('sync-status')!;
  try {
    const r = await fetch('/.netlify/functions/sheets-budget', { headers: h() });
    if (r.ok) {
      budgetRaw = await r.json();
      const tabs = Object.keys(budgetRaw);
      if (tabs.length) {
        activeTab = tabs[0];
        buildTabBar(tabs);
        syncEl.innerHTML = '<span class="sync-dot live"></span>Live — Google Sheets';
        renderTab(activeTab);
        return;
      }
    }
  } catch {}
  // Fall back to mock
  syncEl.innerHTML = '<span class="sync-dot demo"></span>Demo data';
  renderMock();
}

function buildTabBar(tabs: string[]) {
  if (tabs.length <= 1) return;
  const bar = document.getElementById('tab-bar')!;
  bar.style.display = 'flex';
  bar.innerHTML = tabs.map(t =>
    `<button class="tab-btn${t === activeTab ? ' active' : ''}" data-tab="${t}">${t}</button>`
  ).join('');
  bar.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      activeTab = (btn as HTMLElement).dataset.tab!;
      bar.querySelectorAll('.tab-btn').forEach(b => b.classList.toggle('active', b === btn));
      renderTab(activeTab);
    });
  });
}

function renderTab(tab: string) {
  const data = budgetRaw[tab];
  if (!data) return;

  const totalRev = data.totalRevenue?.actual || data.revenue?.reduce((s: number, r: any) => s + (r.actual || 0), 0) || 0;
  const totalExp = data.totalExpenses?.actual || data.expenses?.reduce((s: number, e: any) => s + (e.actual || 0), 0) || 0;
  const balance = data.currentBalance?.actual ?? (totalRev - totalExp);

  document.getElementById('stat-total')!.textContent = fmt(totalRev);
  document.getElementById('stat-spent')!.textContent = fmt(totalExp);
  document.getElementById('stat-remaining')!.textContent = fmt(balance);
  const pct = totalRev > 0 ? Math.round((totalExp / totalRev) * 100) : 0;
  document.getElementById('stat-pct')!.textContent = `${pct}% of revenue spent`;
  const cats = sheetsToCategories(data);
  document.getElementById('stat-cats')!.textContent = String(cats.length);

  renderChart(cats);
  renderList(cats);
}

function renderMock() {
  const cats = [
    { name: 'Flights', budget: 6000, spent: 0 },
    { name: 'Rooms', budget: 5437, spent: 8448 },
    { name: 'Conference Registration', budget: 1560, spent: 5110 },
    { name: 'Theme Park', budget: 550, spent: 550 },
    { name: 'Food + misc', budget: 200, spent: 0 },
  ];
  document.getElementById('stat-total')!.textContent = fmt(21250);
  document.getElementById('stat-spent')!.textContent = fmt(14108);
  document.getElementById('stat-remaining')!.textContent = fmt(10542);
  document.getElementById('stat-pct')!.textContent = 'Demo data';
  document.getElementById('stat-cats')!.textContent = String(cats.length);
  renderChart(cats);
  renderList(cats);
}

let chartInstance: any = null;

function renderChart(cats: { name: string; budget: number; spent: number }[]) {
  const canvas = document.getElementById('budget-chart') as HTMLCanvasElement;
  if (chartInstance) { chartInstance.destroy(); chartInstance = null; }
  if (!cats.length) return;
  const ctx = canvas.getContext('2d')!;
  chartInstance = new (window as any).Chart(ctx, {
    type: 'bar',
    data: {
      labels: cats.map(c => c.name),
      datasets: [
        {
          label: 'Estimated',
          data: cats.map(c => c.budget),
          backgroundColor: 'rgba(30,58,138,0.15)',
          borderColor: '#1e3a8a',
          borderWidth: 1.5,
          borderRadius: 6,
        },
        {
          label: 'Actual',
          data: cats.map(c => c.spent),
          backgroundColor: (ctx2: any) => {
            const cat = cats[ctx2.dataIndex];
            return cat.budget > 0 && cat.spent / cat.budget > 1.1 ? 'rgba(220,38,38,0.75)' : 'rgba(59,130,246,0.75)';
          },
          borderColor: (ctx2: any) => {
            const cat = cats[ctx2.dataIndex];
            return cat.budget > 0 && cat.spent / cat.budget > 1.1 ? '#dc2626' : '#3b82f6';
          },
          borderWidth: 1.5,
          borderRadius: 6,
        },
      ],
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { position: 'top', labels: { font: { family: "'Plus Jakarta Sans', sans-serif", size: 12 }, boxWidth: 12, padding: 16 } },
        tooltip: { callbacks: { label: (ctx2: any) => ` ${ctx2.dataset.label}: ${fmt(ctx2.raw)}` } },
      },
      scales: {
        x: { grid: { display: false }, ticks: { font: { family: "'Plus Jakarta Sans', sans-serif", size: 11 } } },
        y: { grid: { color: '#f1f5f9' }, ticks: { font: { family: "'Plus Jakarta Sans', sans-serif", size: 11 }, callback: (v: any) => fmt(v) } },
      },
    },
  });
}

function renderList(cats: { name: string; budget: number; spent: number }[]) {
  const listEl = document.getElementById('category-list')!;
  if (!cats.length) { listEl.innerHTML = '<p style="color:#94a3b8;text-align:center;padding:1rem">No expense items found</p>'; return; }
  listEl.innerHTML = cats.map(c => {
    const pct = c.budget > 0 ? Math.round((c.spent / c.budget) * 100) : 0;
    const isOver = c.budget > 0 && c.spent > c.budget * 1.05;
    return `
      <div class="cat-row">
        <div class="cat-info">
          <span class="cat-name">${c.name}</span>
          <span class="cat-amounts">${fmt(c.spent)} <span class="cat-of">actual /</span> ${fmt(c.budget)} est.</span>
        </div>
        <div class="progress-bar-track">
          <div class="progress-bar-fill ${isOver ? 'danger' : ''}" style="width:${Math.min(pct,100)}%"></div>
        </div>
        <span class="cat-pct ${isOver ? 'danger' : ''}">${pct}%</span>
      </div>
    `;
  }).join('');
}

async function init() {
  await loadAndRender();
}

init();
</script>

<style>
.tab-bar { gap: 0.5rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
.tab-btn {
  padding: 0.4rem 1rem; border: 1.5px solid #e2e8f0; border-radius: 8px;
  background: white; font-size: 0.82rem; font-weight: 600; color: #475569;
  cursor: pointer; font-family: inherit; transition: all 0.15s;
}
.tab-btn.active { background: #1e3a8a; color: white; border-color: #1e3a8a; }

.sync-status { display: flex; align-items: center; gap: 0.4rem; font-size: 0.8rem; color: #64748b; }
.sync-dot { width: 7px; height: 7px; border-radius: 50%; }
.sync-dot.demo { background: #f59e0b; }
.sync-dot.live { background: #22c55e; animation: pulse 2s infinite; }
@keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }

.green { color: #15803d !important; }
.card-title { font-size: 1rem; font-weight: 700; color: #0f172a; margin: 0 0 1.25rem; }

.budget-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 1.25rem; }
@media (max-width: 900px) { .budget-grid { grid-template-columns: 1fr; } }

.chart-card { position: relative; }
#budget-chart { max-height: 280px; }

.cat-row { display: flex; align-items: center; gap: 0.875rem; padding: 0.625rem 0; border-bottom: 1px solid #f1f5f9; }
.cat-row:last-child { border-bottom: none; }
.cat-info { min-width: 180px; }
.cat-name { display: block; font-size: 0.875rem; font-weight: 600; color: #1e293b; }
.cat-amounts { font-size: 0.75rem; color: #64748b; }
.cat-of { color: #94a3b8; }
.progress-bar-track { flex: 1; height: 6px; background: #f1f5f9; border-radius: 3px; overflow: hidden; }
.progress-bar-fill { height: 100%; background: #3b82f6; border-radius: 3px; transition: width 0.5s; }
.progress-bar-fill.danger { background: #dc2626; }
.cat-pct { font-size: 0.75rem; font-weight: 700; color: #64748b; min-width: 36px; text-align: right; }
.cat-pct.danger { color: #dc2626; }

</style>
