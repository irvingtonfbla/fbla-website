---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="LOOP Pathway - FBLA Chapter" description="Leadership Opportunities and Organizational Programs through our FBLA chapter">
	<section class="page-header">
		<div class="container">
			<h1>LOOP Pathway</h1>
			<p>Leadership Opportunities & Organizational Programs</p>
		</div>
	</section>

	<section class="loop-intro">
		<div class="container">
			<div class="intro-content">
				<div class="intro-text">
					<h2>LOOP: An Opportunity to Excel</h2>
					<p class="highlight">An opportunity to compete in entrepreneurship events and make a real impact in your community!</p>
					<div class="key-points">
						<div class="point">
							<span class="point-icon">🚀</span>
							<span>Open to CTE members as well!</span>
						</div>
						<div class="point">
							<span class="point-icon">🏆</span>
							<span>Loop members also get to compete at Minicon</span>
						</div>
					</div>
				</div>
				<div class="intro-image">
					<div class="image-placeholder loop-visual">
						<svg width="500" height="300" viewBox="0 0 500 300" fill="none" xmlns="http://www.w3.org/2000/svg">
							<rect width="500" height="300" fill="#f8fafc" rx="12"/>
							<circle cx="250" cy="150" r="80" fill="#8b5cf6" opacity="0.2"/>
							<circle cx="250" cy="150" r="60" fill="#8b5cf6" opacity="0.4"/>
							<circle cx="250" cy="150" r="40" fill="#8b5cf6" opacity="0.6"/>
							<circle cx="250" cy="150" r="20" fill="#8b5cf6"/>
							<text x="250" y="155" text-anchor="middle" fill="white" font-size="12" font-weight="bold">LOOP</text>
							<text x="250" y="270" text-anchor="middle" fill="#64748b" font-size="16" font-weight="600">Leadership & Entrepreneurship</text>
						</svg>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="transition-section">
		<div class="container">
			<div class="transition-content">
				<h3>Get involved in...</h3>
			</div>
		</div>
	</section>

	<section class="paradigm-challenge">
		<div class="container">
			<div class="challenge-content">
				<div class="challenge-text">
					<h2>Paradigm Challenge</h2>
					<p class="challenge-subtitle">International challenge where students address real-world problems and come up with innovative solutions</p>
					
					<div class="challenge-info">
						<h3>Example Challenges:</h3>
						<div class="challenge-cards">
							<div class="challenge-card">
								<span class="challenge-icon">🔥</span>
								<span class="challenge-name">Home Fires</span>
							</div>
							<div class="challenge-card">
								<span class="challenge-icon">♻️</span>
								<span class="challenge-name">Waste Reduction</span>
							</div>
							<div class="challenge-card">
								<span class="challenge-icon">🌾</span>
								<span class="challenge-name">Food Security</span>
							</div>
							<div class="challenge-card">
								<span class="challenge-icon">🌿</span>
								<span class="challenge-name">Biodiversity</span>
							</div>
						</div>
					</div>
				</div>
				
				<div class="solution-types">
					<h4>Solutions can be:</h4>
					<div class="solution-grid">
						<div class="solution-item">
							<span class="solution-icon">📦</span>
							<span>Product</span>
						</div>
						<div class="solution-item">
							<span class="solution-icon">🚀</span>
							<span>Project</span>
						</div>
						<div class="solution-item">
							<span class="solution-icon">💡</span>
							<span>Concept</span>
						</div>
						<div class="solution-item">
							<span class="solution-icon">🔧</span>
							<span>Service</span>
						</div>
					</div>
					
					<div class="prize-highlight">
						<h3>$100,000 Prize!</h3>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="government-awareness">
		<div class="container">
			<h2>Government Awareness Challenge</h2>
			<div class="awareness-content">
				<div class="awareness-intro">
					<p class="section-subtitle">Work as a chapter to engage with government officials and promote FBLA values</p>
				</div>
				
				<div class="awareness-steps">
					<div class="step-card">
						<div class="step-number">1</div>
						<div class="step-content">
							<h3>Write to Government Officials</h3>
							<p>5 people write letters to government officials mentioning FBLA related topics in these letters.</p>
							<div class="step-visual">
								<svg width="200" height="120" viewBox="0 0 200 120" fill="none" xmlns="http://www.w3.org/2000/svg">
									<rect width="200" height="120" fill="#dbeafe" rx="8"/>
									<rect x="20" y="20" width="160" height="80" fill="white" rx="4"/>
									<path d="M30 35H170M30 45H150M30 55H160M30 65H140" stroke="#3b82f6" stroke-width="2"/>
									<text x="100" y="110" text-anchor="middle" fill="#1e40af" font-size="10">Letter Writing</text>
								</svg>
							</div>
						</div>
					</div>

					<div class="step-card">
						<div class="step-number">2</div>
						<div class="step-content">
							<h3>Meet Government Officials</h3>
							<p>Meet them on an online call or in person to discuss FBLA initiatives and business education.</p>
							<div class="step-visual">
								<svg width="200" height="120" viewBox="0 0 200 120" fill="none" xmlns="http://www.w3.org/2000/svg">
									<rect width="200" height="120" fill="#dcfce7" rx="8"/>
									<circle cx="70" cy="60" r="25" fill="#10b981" opacity="0.3"/>
									<circle cx="130" cy="60" r="25" fill="#10b981" opacity="0.3"/>
									<path d="M70 50L70 70M130 50L130 70" stroke="#10b981" stroke-width="3"/>
									<text x="100" y="110" text-anchor="middle" fill="#047857" font-size="10">Virtual/In-Person</text>
								</svg>
							</div>
						</div>
					</div>

					<div class="step-card">
						<div class="step-number">3</div>
						<div class="step-content">
							<h3>Invite & Document</h3>
							<p>Invite a government official to talk in person or virtually in an FBLA meeting. Document your experience and the visit.</p>
							<div class="step-visual">
								<svg width="200" height="120" viewBox="0 0 200 120" fill="none" xmlns="http://www.w3.org/2000/svg">
									<rect width="200" height="120" fill="#fce7f3" rx="8"/>
									<rect x="30" y="30" width="140" height="60" fill="white" rx="4"/>
									<circle cx="100" cy="60" r="15" fill="#ec4899"/>
									<text x="100" y="110" text-anchor="middle" fill="#be185d" font-size="10">Documentation</text>
								</svg>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="community-fundraising">
		<div class="container">
			<h2>Community Fundraising Project</h2>
			<div class="fundraising-content">
				<div class="fundraising-overview">
					<h3>Organize and host a chapter fundraiser</h3>
					<p>Learn project management, marketing, and community engagement while making a positive impact.</p>
				</div>
				
				<div class="fundraising-requirements">
					<div class="requirement-card">
						<div class="requirement-icon">
							<svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
								<path d="M19 14C19 18.4 15.4 22 11 22C6.6 22 3 18.4 3 14C3 9.6 6.6 6 11 6C15.4 6 19 9.6 19 14Z" stroke="#8b5cf6" stroke-width="2" fill="none"/>
								<path d="M9 11L12 14L22 4" stroke="#8b5cf6" stroke-width="2" fill="none"/>
							</svg>
						</div>
						<h4>Identify Organization</h4>
						<p>The chapter must identify a specific organization to which the proceeds of a fundraiser will be going to.</p>
					</div>

					<div class="requirement-card">
						<div class="requirement-icon">
							<svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
								<path d="M12 2L15.09 8.26L22 9L17 14L18.18 21L12 17.77L5.82 21L7 14L2 9L8.91 8.26L12 2Z" fill="#8b5cf6"/>
							</svg>
						</div>
						<h4>Flexible Format</h4>
						<p>The fundraiser can be in person or virtual, allowing for creative and innovative approaches.</p>
					</div>

					<div class="requirement-card">
						<div class="requirement-icon">
							<svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
								<path d="M14 2H6C5.46957 2 4.96086 2.21071 4.58579 2.58579C4.21071 2.96086 4 3.46957 4 4V20C4 20.5304 4.21071 21.0391 4.58579 21.4142C4.96086 21.7893 5.46957 22 6 22H18C18.5304 22 19.0391 21.7893 19.4142 21.4142C19.7893 21.0391 20 20.5304 20 20V8L14 2Z" stroke="#8b5cf6" stroke-width="2" fill="none"/>
								<path d="M14 2V8H20" stroke="#8b5cf6" stroke-width="2" fill="none"/>
								<path d="M16 13H8" stroke="#8b5cf6" stroke-width="2" fill="none"/>
								<path d="M16 17H8" stroke="#8b5cf6" stroke-width="2" fill="none"/>
								<path d="M10 9H9H8" stroke="#8b5cf6" stroke-width="2" fill="none"/>
							</svg>
						</div>
						<h4>Documentation</h4>
						<p>A letter explaining the fundraiser will be sent with the donations to the organization's local office.</p>
					</div>
				</div>


			</div>
		</div>
	</section>

	<section class="loop-action">
		<div class="container">
			<div class="action-content">
				<h2>Ready to Lead and Make an Impact?</h2>
				<p>Join our LOOP pathway and discover how leadership opportunities and organizational programs can accelerate your personal and professional growth while making a difference in your community.</p>
				<div class="action-buttons">
					<a href="/contact" class="cta-button primary">Join LOOP Today</a>
					<a href="/officer-team" class="cta-button secondary">Meet Our Leaders</a>
				</div>
			</div>
		</div>
	</section>
</Layout>

<style>
	.page-header {
		background: linear-gradient(135deg, #6b46c1 0%, #8b5cf6 100%);
		color: white;
		padding: calc(92px + 4rem) 0 2rem;
		margin-top: 0;
		text-align: center;
	}

	.page-header h1 {
		font-size: 3rem;
		font-weight: 700;
		margin-bottom: 1rem;
	}

	.page-header p {
		font-size: 1.25rem;
		opacity: 0.9;
	}

	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2rem;
	}

	/* LOOP Intro Section */
	.loop-intro {
		padding: 4rem 0;
		background: #f8fafc;
	}

	.intro-content {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
		align-items: center;
	}

	.intro-text h2 {
		font-size: 2.5rem;
		font-weight: 700;
		color: #1e293b;
		margin-bottom: 1rem;
	}

	.highlight {
		font-size: 1.25rem;
		color: #8b5cf6;
		font-weight: 600;
		line-height: 1.6;
		margin-bottom: 2rem;
	}

	.key-points {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.point {
		display: flex;
		align-items: center;
		gap: 1rem;
		font-size: 1.125rem;
		color: #475569;
		font-weight: 500;
	}

	.point-icon {
		font-size: 1.5rem;
	}

	.intro-image {
		display: flex;
		justify-content: center;
	}

	.image-placeholder {
		border-radius: 12px;
		box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
		transition: transform 0.3s ease;
	}

	.image-placeholder:hover {
		transform: translateY(-5px);
	}

	/* Transition Section */
	.transition-section {
		padding: 2rem 0;
		background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
		text-align: center;
	}

	.transition-content h3 {
		font-size: 1.75rem;
		font-weight: 600;
		color: #475569;
		margin: 0;
	}

	/* Paradigm Challenge Section */
	.paradigm-challenge {
		padding: 4rem 0;
		background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
	}

	.challenge-content {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
		align-items: start;
	}

	.solution-types {
		margin-top: 2rem;
	}

	.challenge-text h2 {
		font-size: 2.5rem;
		font-weight: 700;
		color: #92400e;
		margin-bottom: 1rem;
	}

	.challenge-subtitle {
		font-size: 1.25rem;
		color: #b45309;
		font-weight: 600;
		margin-bottom: 2rem;
		line-height: 1.6;
	}

	.challenge-info h3 {
		font-size: 1.5rem;
		font-weight: 600;
		color: #92400e;
		margin-bottom: 1rem;
	}

	.challenge-cards {
		display: flex;
		gap: 1rem;
		margin-bottom: 2rem;
		flex-wrap: nowrap;
		justify-content: space-between;
	}

	.challenge-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		padding: 1rem;
		background: #fef3c7;
		border: 2px solid #f59e0b;
		border-radius: 12px;
		flex: 1;
		min-width: 120px;
		max-width: 200px;
		text-align: center;
		transition: all 0.3s ease;
		cursor: pointer;
	}

	.challenge-card:hover {
		transform: translateY(-2px);
		box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3);
		background: #fde68a;
	}

	.challenge-name {
		font-size: 0.875rem;
		color: #b45309;
		font-weight: 500;
	}

	.challenge-icon {
		font-size: 1.5rem;
	}

	.solution-types h4 {
		font-size: 1.25rem;
		font-weight: 600;
		color: #92400e;
		margin-bottom: 1rem;
	}

	.solution-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1rem;
		margin-bottom: 2rem;
	}

	.solution-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		background: white;
		padding: 1rem;
		border-radius: 8px;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
	}

	.solution-icon {
		font-size: 1.5rem;
	}

	.solution-item span:last-child {
		font-weight: 600;
		color: #92400e;
	}

	.prize-highlight {
		background: linear-gradient(135deg, #f59e0b, #d97706);
		color: white;
		padding: 1.5rem;
		border-radius: 12px;
		text-align: center;
		box-shadow: 0 4px 15px rgba(245, 158, 11, 0.3);
	}

	.prize-highlight h3 {
		font-size: 2rem;
		font-weight: 700;
		margin: 0;
	}

	/* Government Awareness Section */
	.government-awareness {
		padding: 4rem 0;
		background: white;
	}

	.government-awareness h2 {
		text-align: center;
		font-size: 2.5rem;
		font-weight: 700;
		color: #1e293b;
		margin-bottom: 1rem;
	}

	.section-subtitle {
		text-align: center;
		font-size: 1.25rem;
		color: #64748b;
		margin-bottom: 3rem;
		max-width: 600px;
		margin-left: auto;
		margin-right: auto;
	}

	.awareness-steps {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
	}

	.step-card {
		background: white;
		border-radius: 12px;
		padding: 2rem;
		box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
		border: 1px solid #e2e8f0;
		position: relative;
	}

	.step-number {
		position: absolute;
		top: -15px;
		left: 2rem;
		background: #3b82f6;
		color: white;
		width: 40px;
		height: 40px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		font-weight: bold;
		font-size: 1.25rem;
	}

	.step-content {
		margin-top: 1rem;
	}

	.step-content h3 {
		font-size: 1.25rem;
		font-weight: 600;
		color: #1e293b;
		margin-bottom: 1rem;
	}

	.step-content p {
		color: #64748b;
		line-height: 1.6;
		margin-bottom: 1.5rem;
	}

	.step-visual {
		display: flex;
		justify-content: center;
	}

	/* Community Fundraising Section */
	.community-fundraising {
		padding: 4rem 0;
		background: #f8fafc;
	}

	.community-fundraising h2 {
		text-align: center;
		font-size: 2.5rem;
		font-weight: 700;
		color: #1e293b;
		margin-bottom: 2rem;
	}

	.fundraising-overview {
		text-align: center;
		margin-bottom: 3rem;
	}

	.fundraising-overview h3 {
		font-size: 1.75rem;
		font-weight: 600;
		color: #1e293b;
		margin-bottom: 1rem;
	}

	.fundraising-overview p {
		font-size: 1.125rem;
		color: #64748b;
		max-width: 600px;
		margin: 0 auto;
	}

	.fundraising-requirements {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
		margin-bottom: 3rem;
	}

	.requirement-card {
		background: white;
		border-radius: 12px;
		padding: 2rem;
		box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
		text-align: center;
		border: 1px solid #e2e8f0;
	}

	.requirement-icon {
		margin-bottom: 1rem;
		display: flex;
		justify-content: center;
	}

	.requirement-card h4 {
		font-size: 1.25rem;
		font-weight: 600;
		color: #1e293b;
		margin-bottom: 1rem;
	}

	.requirement-card p {
		color: #64748b;
		line-height: 1.6;
	}



	/* LOOP Action Section */
	.loop-action {
		padding: 4rem 0;
		background: linear-gradient(135deg, #6b46c1 0%, #8b5cf6 100%);
		color: white;
		text-align: center;
	}

	.action-content h2 {
		font-size: 2.5rem;
		font-weight: 700;
		margin-bottom: 1rem;
	}

	.action-content p {
		font-size: 1.25rem;
		margin-bottom: 2rem;
		opacity: 0.9;
		max-width: 700px;
		margin-left: auto;
		margin-right: auto;
	}

	.action-buttons {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	.cta-button {
		display: inline-block;
		padding: 1rem 2rem;
		border-radius: 8px;
		text-decoration: none;
		font-weight: 600;
		transition: all 0.3s ease;
		border: 2px solid transparent;
	}

	.cta-button.primary {
		background: white;
		color: #8b5cf6;
	}

	.cta-button.primary:hover {
		background: #f8fafc;
		transform: translateY(-2px);
	}

	.cta-button.secondary {
		background: transparent;
		color: white;
		border-color: white;
	}

	.cta-button.secondary:hover {
		background: white;
		color: #8b5cf6;
		transform: translateY(-2px);
	}

	/* Responsive Design */
	@media (max-width: 768px) {
		.intro-content,
		.challenge-content {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.page-header h1 {
			font-size: 2rem;
		}

		.intro-text h2,
		.government-awareness h2,
		.community-fundraising h2,
		.action-content h2 {
			font-size: 2rem;
		}

		.challenge-text h2 {
			font-size: 2rem;
		}

		.awareness-steps,
		.fundraising-requirements {
			grid-template-columns: 1fr;
		}

		.solution-grid {
			grid-template-columns: 1fr;
		}

		.challenge-cards {
			flex-direction: column;
			gap: 0.75rem;
		}

		.challenge-card {
			min-width: auto;
			max-width: none;
			flex: none;
			flex-direction: row;
			justify-content: flex-start;
			text-align: left;
			padding: 0.75rem;
		}

		.gallery-grid {
			grid-template-columns: 1fr;
		}

		.action-buttons {
			flex-direction: column;
			align-items: center;
		}

		.container {
			padding: 0 1rem;
		}

		.key-points {
			margin-top: 1rem;
		}
	}
</style>