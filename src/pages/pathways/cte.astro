---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="CTE Pathway - FBLA Chapter" description="Discover the Career Technical Education pathway and how it unlocks FBLA opportunities.">
	<div class="cte-page">
		<!-- Hero Section -->
		<section class="hero">
			<div class="hero-overlay"></div>
			<div class="hero-content">
				<h1 class="animate-fade-in-up">The CTE Pathway</h1>
				<p class="subtitle animate-fade-in-up delay-1">Your Ticket to the FBLA Experience</p>
			</div>
		</section>

		<!-- Introduction Section -->
		<section class="intro-section">
			<div class="container">
				<div class="glass-card intro-card">
					<div class="content-split">
						<div class="text-col">
							<h2>What is CTE?</h2>
							<p>
								<strong>Career Technical Education (CTE)</strong> is the foundation of FBLA eligibility at Irvington High School. 
								To participate in FBLA, compete in events, and travel to conferences, you must be enrolled in a CTE course.
							</p>
							<p>
								It's not just a requirement—it's an opportunity to gain real-world skills in technology, business, arts, and health 
								while unlocking the full FBLA experience.
							</p>
						</div>
						<div class="image-col">
							<div class="image-wrapper">
								<img src="/cte1.jpg" alt="FBLA Members at Conference" class="rounded-img shadow-lg hover-scale" />
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Courses Section -->
		<section class="courses-section">
			<div class="container">
				<h2 class="section-title">Qualifying Courses</h2>
				<p class="section-desc">Enroll in any of these Irvington High School CTE courses to join FBLA:</p>
				
				<div class="cards-grid">
					<div class="simple-course-card">
						<div class="icon">🚀</div>
						<h3>Entrepreneurship</h3>
					</div>

					<div class="simple-course-card">
						<div class="icon">📈</div>
						<h3>Entrepreneurial Marketing</h3>
					</div>

					<div class="simple-course-card">
						<div class="icon">📷</div>
						<h3>Digital Photo</h3>
					</div>

					<div class="simple-course-card">
						<div class="icon">🖼️</div>
						<h3>Digital Imaging</h3>
					</div>

					<div class="simple-course-card">
						<div class="icon">💻</div>
						<h3>AP CSA</h3>
					</div>

					<div class="simple-course-card">
						<div class="icon">🌐</div>
						<h3>Intro to Internet Engineering</h3>
					</div>
				</div>
			</div>
		</section>

		<!-- Benefits Section -->
		<section class="benefits-section">
			<div class="container">
				<h2 class="section-title">Why Join?</h2>
				<div class="benefits-grid">
					<div class="benefit-item">
						<div class="benefit-image">
							<img src="/cte2.JPG" alt="FBLA Conference Fun" />
							<div class="overlay">
								<h3>Conferences</h3>
								<p>Attend BSLC, SLC, and NLC!</p>
							</div>
						</div>
					</div>
					<div class="benefit-item wide blue-card">
						<div class="benefit-content">
							<h3>Travel & Memories</h3>
							<p>Go to theme parks, travel to different cities, and make lifelong memories with friends.</p>
							<ul class="perks-list">
								<li>✈️ Travel Opportunities</li>
								<li>🎢 Theme Park Visits</li>
								<li>🤝 Meet New People</li>
							</ul>
						</div>
					</div>
					<div class="benefit-item">
						<div class="benefit-image">
							<img src="/cte4.jpg" alt="Theme Park Visits" />
							<div class="overlay">
								<h3>Theme Park Visits</h3>
								<p>Travel to different cities & parks!</p>
							</div>
						</div>
					</div>
					<div class="benefit-item">
						<div class="benefit-image">
							<img src="/cte5.jpg" alt="Awards and Recognition" />
							<div class="overlay">
								<h3>Competition</h3>
								<p>Win awards & boost college apps!</p>
							</div>
						</div>
					</div>
					<div class="benefit-item">
						<div class="benefit-image">
							<img src="/cte2.png" alt="Networking" />
							<div class="overlay">
								<h3>FBLA Family</h3>
								<p>Join a supportive community.</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>
		
		<!-- CTA Section -->
		<section class="cta-section">
			<div class="container">
				<h2>Ready to Start Your Journey?</h2>
				<p>Make sure you're enrolled in a CTE course and join us!</p>
				<a href="/#contact" class="btn-glow">Join FBLA Today</a>
			</div>
		</section>
	</div>
</Layout>

<script>
	// Simple Vanilla JS for 3D Tilt Effect
	document.addEventListener('DOMContentLoaded', () => {
		const cards = document.querySelectorAll('[data-tilt]');
		
		cards.forEach(card => {
			card.addEventListener('mousemove', (e) => {
				const rect = (card as HTMLElement).getBoundingClientRect();
				const x = e.clientX - rect.left;
				const y = e.clientY - rect.top;
				
				const centerX = rect.width / 2;
				const centerY = rect.height / 2;
				
				const rotateX = ((y - centerY) / centerY) * -10; // Max rotation deg
				const rotateY = ((x - centerX) / centerX) * 10;
				
				(card as HTMLElement).style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.05, 1.05, 1.05)`;
			});
			
			card.addEventListener('mouseleave', () => {
				(card as HTMLElement).style.transform = 'perspective(1000px) rotateX(0) rotateY(0) scale3d(1, 1, 1)';
			});
		});
	});
</script>

<style>
	:root {
		--primary: #00529b; /* FBLA Blue */
		--secondary: #be2c37; /* FBLA Red */
		--accent: #fcd116; /* FBLA Gold/Yellow - approximated */
		--dark: #1a1a1a;
		--light: #f8f9fa;
		--glass: rgba(255, 255, 255, 0.1);
		--glass-border: rgba(255, 255, 255, 0.2);
	}

	.cte-page {
		font-family: 'Plus Jakarta Sans', sans-serif;
		color: var(--dark);
		overflow-x: hidden;
	}

	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2rem;
	}

	/* Hero Section */
	.hero {
		height: 80vh;
		background-image: url('/cte2.JPG'); /* Using one of the user images as hero bg */
		background-size: cover;
		background-position: center;
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		color: white;
	}

	.hero-overlay {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: linear-gradient(135deg, rgba(0, 82, 155, 0.9), rgba(0, 0, 0, 0.8));
	}

	.hero-content {
		position: relative;
		z-index: 2;
	}

	.hero h1 {
		font-size: 4rem;
		font-weight: 800;
		margin-bottom: 1rem;
		text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
	}

	.hero .subtitle {
		font-size: 1.5rem;
		font-weight: 300;
		opacity: 0.9;
	}

	/* Animations */
	@keyframes bounce {
		0%, 20%, 50%, 80%, 100% {transform: translateY(0) translateX(-50%);}
		40% {transform: translateY(-10px) translateX(-50%);}
		60% {transform: translateY(-5px) translateX(-50%);}
	}

	.animate-fade-in-up {
		animation: fadeInUp 1s ease-out forwards;
		opacity: 0;
		transform: translateY(20px);
	}

	.delay-1 { animation-delay: 0.3s; }

	@keyframes fadeInUp {
		to { opacity: 1; transform: translateY(0); }
	}

	/* Intro Section */
	.intro-section {
		padding: 6rem 0;
		background: var(--light);
	}

	.glass-card {
		background: white;
		border-radius: 20px;
		box-shadow: 0 20px 40px rgba(0,0,0,0.1);
		padding: 3rem;
		border: 1px solid rgba(0,0,0,0.05);
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}

	.glass-card:hover {
		transform: translateY(-5px);
		box-shadow: 0 25px 50px rgba(0,0,0,0.15);
	}

	.content-split {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
		align-items: center;
	}

	.text-col h2 {
		font-size: 2.5rem;
		margin-bottom: 1.5rem;
		color: var(--primary);
	}

	.text-col p {
		font-size: 1.1rem;
		line-height: 1.6;
		margin-bottom: 1.5rem;
		color: #555;
	}

	.rounded-img {
		border-radius: 15px;
		width: 100%;
		height: auto;
		transition: transform 0.3s ease;
	}
	
	.hover-scale:hover {
		transform: scale(1.03);
	}

	/* Courses Section */
	.courses-section {
		padding: 6rem 0;
		background: white;
	}

	.section-title {
		text-align: center;
		font-size: 3rem;
		margin-bottom: 1rem;
		color: var(--dark);
	}

	.section-desc {
		text-align: center;
		font-size: 1.2rem;
		color: #666;
		margin-bottom: 4rem;
	}

	.cards-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 2rem;
	}

	.course-card {
		background-color: transparent;
		perspective: 1000px;
		height: 300px;
		cursor: pointer;
	}

	.card-inner {
		position: relative;
		width: 100%;
		height: 100%;
		text-align: center;
		transition: transform 0.6s;
		transform-style: preserve-3d;
		box-shadow: 0 4px 8px 0 rgba(0,0,0,0.1);
		border-radius: 15px;
	}

	.course-card:hover .card-inner {
		transform: rotateY(180deg);
	}

	.card-front, .card-back {
		position: absolute;
		width: 100%;
		height: 100%;
		-webkit-backface-visibility: hidden;
		backface-visibility: hidden;
		border-radius: 15px;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		padding: 2rem;
	}

	.card-front {
		background: linear-gradient(135deg, #ffffff, #f0f4f8);
		color: black;
		border: 1px solid #e1e4e8;
	}

	.card-back {
		background: linear-gradient(135deg, var(--primary), #003366);
		color: white;
		transform: rotateY(180deg);
	}

	.icon {
		font-size: 4rem;
		margin-bottom: 1rem;
	}

	.course-card h3 {
		font-size: 1.5rem;
		margin-bottom: 0.5rem;
	}

	.simple-course-card {
		background: white;
		border-radius: 15px;
		padding: 2rem;
		text-align: center;
		box-shadow: 0 10px 30px rgba(0,0,0,0.05);
		transition: all 0.3s ease;
		border: 1px solid rgba(0,0,0,0.05);
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		height: 200px;
	}

	.simple-course-card:hover {
		transform: translateY(-5px);
		box-shadow: 0 20px 40px rgba(0,82,155,0.15);
		border-color: var(--primary);
	}

	.simple-course-card .icon {
		font-size: 3rem;
		margin-bottom: 1rem;
	}

	.simple-course-card h3 {
		font-size: 1.25rem;
		color: var(--dark);
		margin: 0;
	}

	/* Benefits Section */
	.benefits-section {
		padding: 6rem 0;
		background: #f0f4f8;
	}

	.benefits-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		grid-auto-rows: 300px;
		gap: 1.5rem;
	}

	.benefit-item {
		position: relative;
		border-radius: 20px;
		overflow: hidden;
		background: white;
		box-shadow: 0 10px 20px rgba(0,0,0,0.05);
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}
	
	.benefit-item:hover {
		transform: translateY(-5px);
		box-shadow: 0 15px 30px rgba(0,0,0,0.1);
	}

	.benefit-item.wide {
		grid-column: span 2;
		background: linear-gradient(135deg, var(--primary), #003366);
		color: white;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.cte-list {
		list-style: none;
		padding: 0;
		margin-top: 1rem;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1rem;
		text-align: left;
	}

	.cte-list li {
		padding: 0.5rem 0;
		border-bottom: 1px solid rgba(255,255,255,0.2);
		font-size: 0.95rem;
		opacity: 0.9;
	}
	
	.cte-list li:last-child, .cte-list li:nth-last-child(2) {
		border-bottom: none;
	}

	.benefit-image {
		width: 100%;
		height: 100%;
		position: relative;
	}

	.benefit-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s ease;
	}

	.benefit-item:hover .benefit-image img {
		transform: scale(1.1);
	}

	.overlay {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);
		padding: 2rem;
		color: white;
	}

	.benefit-content {
		padding: 3rem;
	}
	
	.benefit-content h3 {
		font-size: 2rem;
		margin-bottom: 1rem;
	}
	
	.perks-list {
		list-style: none;
		padding: 0;
		margin-top: 1.5rem;
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
	}
	
	.perks-list li {
		background: rgba(255,255,255,0.2);
		padding: 0.5rem 1rem;
		border-radius: 50px;
		font-size: 0.9rem;
	}

	/* CTA Section */
	.cta-section {
		padding: 6rem 0;
		text-align: center;
		background: white;
	}
	
	.cta-section h2 {
		font-size: 2.5rem;
		color: var(--primary);
		margin-bottom: 1rem;
	}
	
	.btn-glow {
		display: inline-block;
		margin-top: 2rem;
		padding: 1rem 3rem;
		background: var(--primary);
		color: white;
		text-decoration: none;
		border-radius: 50px;
		font-weight: bold;
		font-size: 1.2rem;
		box-shadow: 0 0 20px rgba(0, 82, 155, 0.4);
		transition: all 0.3s ease;
	}
	
	.btn-glow:hover {
		background: var(--secondary);
		box-shadow: 0 0 30px rgba(190, 44, 55, 0.6);
		transform: translateY(-2px);
	}

	/* Responsive */
	@media (max-width: 768px) {
		.hero h1 { font-size: 2.5rem; }
		.content-split { grid-template-columns: 1fr; }
		.benefits-grid { grid-template-columns: 1fr; grid-auto-rows: 250px; }
		.benefit-item.wide { grid-column: span 1; }
	}
</style>